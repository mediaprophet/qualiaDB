      "homepage": "https://wordnet.princeton.edu",
      "sampleQueries": [
        { "label": "Find 'dog'",      "pattern": "?s ?p \"dog\"" },
        { "label": "Find 'cat'",      "pattern": "?s ?p \"cat\"" },
        { "label": "Find 'computer'", "pattern": "?s ?p \"computer\"" },
        { "label": "Find 'water'",    "pattern": "?s ?p \"water\"" },
        { "label": "Find 'mind'",     "pattern": "?s ?p \"mind\"" }
      ]
    },
    {
      "id": "schemaorg-30",
      "profile": "schemaorg",
      "label": "Schema.org 30.0",
      "icon": "🌐",
      "description": "Schema.org vocabulary release 30.0 · ~18k triples · built by scripts/prepare_schemaorg_benchmark.sh in CI",
      "url": "data/schemaorg/30.0/schemaorg-current-https.q42",
      "lexUrl": "data/schemaorg/30.0/schemaorg-current-https.q42.lex",
      "bidxUrl": "data/schemaorg/30.0/schemaorg-current-https.q42.bidx",
