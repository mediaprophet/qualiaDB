        {
          "label": "Find 'dog'",
          "pattern": "?s ?p \"dog\""
        },
        {
          "label": "Find 'cat'",
          "pattern": "?s ?p \"cat\""
        },
        {
          "label": "Find 'computer'",
          "pattern": "?s ?p \"computer\""
        },
        {
          "label": "Find 'water'",
          "pattern": "?s ?p \"water\""
        },
        {
          "label": "Find 'mind'",
          "pattern": "?s ?p \"mind\""
        }
      ]
    },
