        { "label": "Person type",       "pattern": "<https://schema.org/Person> ?p ?o" },
        { "label": "Organization",      "pattern": "<https://schema.org/Organization> ?p ?o" },
        { "label": "CreativeWork",      "pattern": "<https://schema.org/CreativeWork> ?p ?o" },
        { "label": "video type",        "pattern": "<https://schema.org/video> ?p ?o" },
        { "label": "name property",     "pattern": "?s ?p \"name\"" }
      ]
