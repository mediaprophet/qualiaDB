; QBS-01/QBS-06 plaintext candidate schema, revision 1.
; Shape only: codec additionally enforces deterministic shortest CBOR, exact key
; order, no tags/indefinite values/trailing bytes, cross-page invariants,
; nonzero refs/nonce, context consistency, extents and cumulative byte budgets.
; CDDL alone does not establish authority, disclosure or consumer permission.
; Reference notation: https://www.rfc-editor.org/rfc/rfc8610.html
profile = "qbdl-stream-pq-1"
digest48 = bstr .size 48
nonce32 = bstr .size 32
u32 = 0..4294967295
u64 = 0..18446744073709551615
entry-count = 0..4096
logical-length = 0..1099511627776
predecessor = digest48 / null
page-ref = [0..31, 0..4095, 1..128, 1..65536, digest48]
source-commit = {
  0: 64..1099511627776,
  1: 1,
  2: 0 / 1,
  3: digest48,
  4: u64,
  5: u64,
  6: digest48,
  7: digest48
}
context-entry = [u32, logical-length, 0, 0]
context-page = {
  0: profile,
  1: 1,
  2: 0..31,
  3: 0..4095,
  4: [1*128 context-entry]
}
context-root = {
  0: profile,
  1: 1,
  2: nonce32,
  3: u64,
  4: predecessor,
  5: source-commit,
  6: 16384,
  7: entry-count,
  8: [0*32 page-ref],
  9: 0,
  10: digest48,
  11: digest48,
  12: digest48
}
entry-record = [u32, 0..4095, tstr .size (1..64), u64, u64, logical-length, 0, 0, digest48]
entry-page = {
  0: profile,
  1: 1,
  2: digest48,
  3: 0..31,
  4: 0..4095,
  5: [1*128 entry-record]
}
descriptor-body = {
  0: profile,
  1: 1,
  2: digest48,
  3: bstr .cbor context-root,
  4: u64,
  5: predecessor,
  6: entry-count,
  7: [0*32 page-ref]
}
