    rdfs:label "Subalpine Ectomycorrhizal Fungal Guild (Basidiomycota / Ascomycota)"@en .

# RO:0002081 = co-occurs with / overlapping niche; RO:0002434 = interacts with;
# RO:0002444 = symbiont of / mutualist; RO:0002470 = eaten by / host for
qualia:eucalyptus_dalrympleana
    ro:0002081 qualia:eucalyptus_pauciflora ,
               qualia:eucalyptus_delegatensis ,
               qualia:eucalyptus_dives ;
    ro:0002444 qualia:ectomycorrhizal_fungi ;
    ro:0002434 qualia:phascolarctos_cinereus ,
               qualia:petauroides_volans ,
               qualia:wallabia_bicolor ;
    q42:biome envo:01000221 , envo:00000446 ;
    rdfs:comment "Forms tall montane and subalpine wet/grassy sclerophyll forests (600-1400 m AHD) alongside E. delegatensis, E. pauciflora, and E. dives; provides arboreal folivory forage and veteran tree hollows for Petauroides volans and Phascolarctos cinereus, and sapling browse for Wallabia bicolor."@en ;
    prov:wasDerivedFrom src:vicflora , src:plantnet , src:ala .

