# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:eucalyptus_viminalis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus viminalis Labill." ;
    rdfs:label "Manna Gum"@en .

qualia:eucalyptus_pauciflora_niphophila a dwc:Taxon ;
    dwc:scientificName "Eucalyptus pauciflora subsp. niphophila (Maiden & Blakely) L.A.S.Johnson & Blaxell" ;
    rdfs:label "Alpine Snow Gum"@en .

qualia:eucalyptus_dalrympleana_heptantha a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dalrympleana subsp. heptantha L.A.S.Johnson" ;
    rdfs:label "Northern Mountain Gum (7-budded umbel)"@en .

qualia:eucalyptus_dalrympleana_poliophylla a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dalrympleana subsp. poliophylla L.A.S.Johnson" ;
    rdfs:label "Victorian Glaucous Mountain Gum"@en .

qualia:eucalyptus_dalrympleana
    owl:differentFrom qualia:eucalyptus_viminalis ,
                      qualia:eucalyptus_pauciflora_niphophila ,
                      qualia:eucalyptus_dalrympleana_heptantha ,
                      qualia:eucalyptus_dalrympleana_poliophylla ;
    rdfs:comment "Taxonomic boundary: do not substitute E. viminalis (narrower juvenile leaves), E. pauciflora subsp. niphophila (alpine snowgum), E. dalrympleana subsp. heptantha (7-budded northern umbels), or subsp. poliophylla (dull grey-green/glaucous adult leaves)."@en .

