    rdfs:label "Alpine Ash"@en .

qualia:eucalyptus_dives a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dives Schauer" ;
    rdfs:label "Broad-leaved Peppermint"@en .

qualia:phascolarctos_cinereus a dwc:Taxon ;
    dwc:scientificName "Phascolarctos cinereus (Goldfuss, 1817)" ;
    rdfs:label "Koala"@en .

