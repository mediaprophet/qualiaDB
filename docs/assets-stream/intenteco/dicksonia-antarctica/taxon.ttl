    dct:identifier <urn:qualia:taxon:dicksonia_antarctica> ,
                   <did:q42:taxon:dicksonia_antarctica> ;
    rdfs:label "Soft Tree Fern"@en ,
               "Dicksonia antarctica Labill."@la ;
