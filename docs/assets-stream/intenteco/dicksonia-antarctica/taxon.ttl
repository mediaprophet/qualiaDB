    rdfs:label "DID Q42 Locator — Dicksonia antarctica Labill."@en .

# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:cyathea_australis a dwc:Taxon ;
    dwc:scientificName "Cyathea australis (R.Br.) Domin" ;
    rdfs:label "Rough Tree Fern"@en .

qualia:dicksonia_youngiae a dwc:Taxon ;
    dwc:scientificName "Dicksonia youngiae C.Moore ex Baker" ;
    rdfs:label "Bristly Tree Fern"@en .

qualia:todea_barbara a dwc:Taxon ;
    dwc:scientificName "Todea barbara (L.) T.Moore" ;
    rdfs:label "King Fern"@en .

qualia:dicksonia_antarctica
    owl:differentFrom qualia:cyathea_australis ,
                      qualia:dicksonia_youngiae ,
                      qualia:todea_barbara ;
    rdfs:comment "Taxonomic boundary: do not substitute Cyathea australis (Cyatheaceae: hard tubercled/spiny trunk, shiny scales rather than hairs on stipe bases, dorsal round sori on veins rather than marginal bivalved sori), Dicksonia youngiae (slender trunk with dark rigid bristles, northern NSW / SE QLD), or Todea barbara (Osmundaceae: broad mounding caudex, bipinnate fronds, naked sporangia covering basal pinnules)."@en .

