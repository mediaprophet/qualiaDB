    rdfs:label "Superb Lyrebird"@en .

# RO:0002081 = co-occurs with / overlapping niche;
# RO:0002454 = has host / serves as habitat host for (epiphyte host);
# RO:0002434 = interacts with
qualia:dicksonia_antarctica
    ro:0002081 qualia:eucalyptus_regnans ,
               qualia:nothofagus_cunninghamii ,
               qualia:acacia_dealbata ,
               qualia:cyathea_australis ;
    ro:0002454 qualia:tmesipteris_elongata ,
               qualia:hymenophyllum_flabellatum ,
               qualia:bryophyta_epiphyte_guild ;
    ro:0002434 qualia:platycercus_elegans ,
               qualia:menura_novaehollandiae ;
    q42:biome envo:01000221 , envo:00000446 ;
    rdfs:comment "Mid-storey cool-temperate rainforest and wet-sclerophyll gully microclimate keystone underneath emergent Eucalyptus regnans and Nothofagus cunninghamii; fibrous moist caudex serves as critical vascular epiphyte substrate for Tmesipteris elongata, Hymenophyllum flabellatum, and bryophyte/fungal mats; spores consumed by Platycercus elegans; fern-gully floor grazed/foraged by Menura novaehollandiae."@en ;
    prov:wasDerivedFrom src:vicflora , src:ala , src:flora-of-australia .

