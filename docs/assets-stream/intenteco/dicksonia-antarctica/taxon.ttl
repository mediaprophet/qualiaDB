    dwc:scientificName "Acacia dealbata Link" ;
    rdfs:label "Silver Wattle"@en .

qualia:tmesipteris_elongata a dwc:Taxon ;
    dwc:scientificName "Tmesipteris elongata P.A.Dang." ;
    rdfs:label "Slender Fork-fern"@en .

qualia:hymenophyllum_flabellatum a dwc:Taxon ;
    dwc:scientificName "Hymenophyllum flabellatum Labill." ;
    rdfs:label "Shiny Filmy-fern"@en .

qualia:bryophyta_epiphyte_guild a dwc:Taxon ;
    rdfs:label "Gully Epiphytic Bryophyte & Saprotrophic Fungal Guild"@en .

qualia:platycercus_elegans a dwc:Taxon ;
    dwc:scientificName "Platycercus elegans (Gmelin, 1788)" ;
    rdfs:label "Crimson Rosella"@en .

qualia:menura_novaehollandiae a dwc:Taxon ;
