# 4. Joint Range-of-Motion (ROM) & Injury Threshold Assertions (Radians)
# ============================================================================

rom:shoulder a q42:JointROM ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:romJoint "shoulder" ;
    q42:anatomicalTarget anat:webbed_rowing_forelimbs_and_venom_spurred_hindlimbs , anat:osteology_and_myology ;
    q42:primaryAxis "horizontal_rotational_rowing_sweep" ;
    q42:healthyMinRad "-1.15"^^xsd:decimal ;
    q42:healthyMaxRad "1.25"^^xsd:decimal ;
    q42:abductionMinRad "-0.45"^^xsd:decimal ;
    q42:abductionMaxRad "0.95"^^xsd:decimal ;
    q42:injuryThresholdRad "1.45"^^xsd:decimal ;
    q42:obligatePostInjuryBehavior "q42:obligateForelimbRowingUnloadAndBankRetreat" ;
    rdfs:label "Sprawled Glenohumeral Shoulder Joint ROM (Ornithorhynchus anatinus)"@en .

rom:elbow a q42:JointROM ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:romJoint "elbow" ;
    q42:anatomicalTarget anat:webbed_rowing_forelimbs_and_venom_spurred_hindlimbs ;
    q42:primaryAxis "flexion_extension_and_pronation" ;
    q42:healthyMinRad "-1.75"^^xsd:decimal ;
    q42:healthyMaxRad "-0.15"^^xsd:decimal ;
    q42:injuryThresholdRad "-1.98"^^xsd:decimal ;
    q42:obligatePostInjuryBehavior "q42:obligateForelimbRowingUnloadAndBankRetreat" ;
