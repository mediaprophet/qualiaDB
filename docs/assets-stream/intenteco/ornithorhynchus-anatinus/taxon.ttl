claim:sole-extant-ornithorhynchid a rdf:Statement ;
    rdf:subject qualia:ornithorhynchus_anatinus ;
    rdf:predicate q42:functionalGuild ;
    rdf:object "semi_aquatic_oviparous_electrosensory_monotreme" ;
    rdfs:comment "Ornithorhynchus anatinus is the sole extant member of family Ornithorhynchidae (order Monotremata), distinguished by its pliable electrosensory duck-like bill, dense dual-layer waterproof pelage, fan-webbed rowing forepaws, beaver-like fat-storing paddle tail, oviparous reproduction, and crural venom gland/calcaneal spur in males."@en .

# ============================================================================
# 2. Anatomical Subsystems (UBERON: Bill/Cranium, Torso/Tail, Limbs, Osteology & Myology)
# ============================================================================

# --- Subsystem A: Electrosensory Duck Bill & Cranium (UBERON:0000975 & UBERON:0001456) ---

anat:electrosensory_duck_bill_and_cranium a uberon:0000975 , uberon:0001456 , uberon:0003129 , uberon:0004096 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0000975" ;
    q42:secondaryUberonCurie "UBERON:0001456" ;
    q42:cranialUberonCurie "UBERON:0003129" ;
    q42:rostrumUberonCurie "UBERON:0004096" ;
    q42:subsystemId "electrosensory_duck_bill_and_cranium" ;
    q42:anatomyLayer "integument_sensory_and_cranium" ;
    ro:0002131 qualia:ornithorhynchus_anatinus ;
    q42:billLengthMm "60.0"^^xsd:decimal ;
    q42:billWidthMm "50.0"^^xsd:decimal ;
    q42:billSurface "Pliable, smooth, leathery slate-black dorsal bill shield and paler mottled lower mandibular bill with backward-extending frontal and mandibular cutaneous shield flaps at the bill base" ;
    q42:nostrilPlacement "Paired dorsal sub-terminal slit nostrils near tip of upper bill, closing during dives" ;
    q42:electroreceptorCount "40000"^^xsd:integer ;
    q42:electroreceptorType "ampullary_electroreceptor (modified mucous glands)" ;
    q42:electroreceptorSensitivityUvCmMin "50.0"^^xsd:decimal ;
    q42:electroreceptorSensitivityUvCmMax "250.0"^^xsd:decimal ;
    q42:mechanoreceptorCount "60000"^^xsd:integer ;
    q42:mechanoreceptorType "push_rod_mechanoreceptor (20 um displacement threshold)" ;
    q42:receptorArrayGeometry "Parasagittal longitudinal stripes across dorsal and ventral bill skin enabling bimodal electrolocation and hydrodynamic wave time-delay ranging" ;
    q42:oralApparatus "Expansible cheek pouches storing benthic prey underwater + four keratinous horny grinding pads replacing shed deciduous juvenile molars" ;
    q42:ocularAuricularFurrow "Combined eye-and-ear facial groove (ocular_auricular_furrow) lacking external pinnae that closes watertight during underwater foraging, bordered ventrally by pale buff-cream suborbital eye spots" ;
    rdfs:label "Electrosensory Duck Bill, Cutaneous Shield Flaps, Cranium & Ocular-Auricular Furrow"@en ;
    prov:wasDerivedFrom src:australian-platypus-conservancy , src:nsw-dpe-platypus .

anat:ampullary_electroreceptor a uberon:0001456 , q42:SensoryOrgan ;
    q42:uberonCurie "UBERON:0001456" ;
    q42:subsystemId "ampullary_electroreceptor" ;
    ro:0002131 anat:electrosensory_duck_bill_and_cranium ;
    q42:receptorCount "40000"^^xsd:integer ;
    q42:sensitivityRangeUvCm "50 to 250" ;
    q42:histologicalOrigin "Modified bill-skin mucous glands innervated by trigeminal ophthalmic and maxillary branches" ;
    rdfs:label "Bill Mucous-Gland Electroreceptors (~40,000)"@en .

anat:push_rod_mechanoreceptor a uberon:0001456 , q42:SensoryOrgan ;
    q42:uberonCurie "UBERON:0001456" ;
    q42:subsystemId "push_rod_mechanoreceptor" ;
    ro:0002131 anat:electrosensory_duck_bill_and_cranium ;
    q42:receptorCount "60000"^^xsd:integer ;
    q42:displacementThresholdUm "20.0"^^xsd:decimal ;
    rdfs:label "Bill Push-Rod Mechanoreceptors (~60,000)"@en .

# --- Subsystem B: Hydrodynamic Torpedo Torso & Paddle Tail (UBERON:0001130 & UBERON:0002415) ---

anat:hydrodynamic_torpedo_torso_and_paddle_tail a uberon:0001130 , uberon:0002415 , uberon:0002416 , uberon:0002099 , uberon:0000162 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001130" ;
    q42:tailUberonCurie "UBERON:0002415" ;
    q42:integumentUberonCurie "UBERON:0002416" ;
    q42:pelageUberonCurie "UBERON:0002099" ;
    q42:cloacaUberonCurie "UBERON:0000162" ;
    q42:subsystemId "hydrodynamic_torpedo_torso_and_paddle_tail" ;
    q42:anatomyLayer "torso_tail_integument_pelage" ;
    ro:0002131 qualia:ornithorhynchus_anatinus ;
    q42:bodyPlan "Dorsoventrally streamlined low-slung semi-aquatic torpedo torso (~0.45-0.55 m typical total length; 0.39-0.60 m full adult range)" ;
    q42:pelageDensityHairsPerMm2Min "800"^^xsd:integer ;
    q42:pelageDensityHairsPerMm2Max "900"^^xsd:integer ;
    q42:pelageStructure "Dual-layer waterproof coat (coarse flattened guard hairs overlying dense kinked underfur) trapping an insulating air boundary layer underwater" ;
    q42:coatColorPattern "Rich dark umber-brown dorsum, warm chestnut-brown flanks, and silvery-amber to ochre-cream ventrum" ;
    q42:tailMorphology "Broad, dorsoventrally flattened beaver-like paddle tail storing ~40-50% of body lipid reserves and acting as a hydrodynamic stabilizer/rudder during dives" ;
    q42:tailLengthMinM "0.10"^^xsd:decimal ;
    q42:tailLengthMaxM "0.15"^^xsd:decimal ;
    q42:cloacalAnatomy "Single posterior monotreme cloaca (UBERON:0000162) serving urinary, fecal, and oviparous reproductive tracts" ;
    rdfs:label "Hydrodynamic Torpedo Torso, Dual-Layer Waterproof Pelage, Fat-Storing Paddle Tail & Cloaca"@en ;
    prov:wasDerivedFrom src:vic-wildlife-other-mammals , src:australian-platypus-conservancy .

# --- Subsystem C: Webbed Rowing Forelimbs & Venom-Spurred Hindlimbs (UBERON:0002102 & UBERON:0002103) ---

anat:webbed_rowing_forelimbs_and_venom_spurred_hindlimbs a uberon:0002102 , uberon:0002103 , uberon:0002398 , uberon:0002387 , uberon:0001465 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0002102" ;
    q42:secondaryUberonCurie "UBERON:0002103" ;
    q42:manusUberonCurie "UBERON:0002398" ;
    q42:pesUberonCurie "UBERON:0002387" ;
    q42:clawUberonCurie "UBERON:0001465" ;
    q42:subsystemId "webbed_rowing_forelimbs_and_venom_spurred_hindlimbs" ;
    q42:anatomyLayer "appendicular_locomotion_and_venom_apparatus" ;
    ro:0002131 qualia:ornithorhynchus_anatinus ;
    q42:pectoralGirdleMechanics "Sprawled monotreme pectoral girdle (T-shaped interclavicle, coracoids, epicoracoids, curved scapulae) supporting figure-eight alternating forelimb rowing strokes" ;
    q42:forepawWebbing "Fan-webbed 5-digit forepaws: leathery swimming membrane extends ~10-15 mm beyond the 5 curved digging claws underwater and folds backward beneath the palm on land to expose claws for burrow excavation" ;
    q42:hindlimbFunction "Partially webbed 5-clawed steering hind feet rotated posteriorly as hydrodynamic rudders and braking stabilizers underwater, plantigrade-knuckle crawl on land" ;
    q42:venomApparatusId "calcaneal_venom_spur" ;
    q42:venomApparatusDescription "Hollow keratinous tarsal/calcaneal spur (~15 mm) on medial hind ankle connected via duct to crural venom gland beneath thigh musculature; functional in adult males (seasonal breeding peak) and regresses in females by ~12 months" ;
    rdfs:label "Alternating-Stroke Fan-Webbed Forepaws & Calcaneal Venom-Spurred Hindlimbs"@en ;
    prov:wasDerivedFrom src:nsw-dpe-platypus , src:australian-platypus-conservancy .

anat:calcaneal_venom_spur a uberon:0002103 , uberon:0002387 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0002103" ;
    q42:subsystemId "calcaneal_venom_spur" ;
    ro:0002131 anat:webbed_rowing_forelimbs_and_venom_spurred_hindlimbs ;
    q42:spurLengthMm "15.0"^^xsd:decimal ;
    q42:sexExpression "Functional in adult males; vestigial sheath shed in juvenile females (~8-12 months)" ;
    q42:venomDelivery "Crural gland (dorsal thigh) -> crural duct -> hollow keratinous calcaneal spur (defensin-like peptides, C-type natriuretic peptides, nerve growth factor)" ;
    rdfs:label "Male Calcaneal Venom Spur & Crural Gland Apparatus (calcaneal_venom_spur)"@en .

# --- Subsystem D: Osteology & Myology (UBERON:0001434 & UBERON:0001630, 24-Joint PGA Rig) ---

anat:osteology_and_myology a uberon:0001434 , uberon:0001630 , uberon:0002228 , uberon:0003661 , uberon:0000976 , uberon:0000981 , uberon:0002356 , uberon:0001498 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001434" ;
    q42:myologyUberonCurie "UBERON:0001630" ;
    q42:ribUberonCurie "UBERON:0002228" ;
    q42:epipubicUberonCurie "UBERON:0003661" ;
    q42:humerusUberonCurie "UBERON:0000976" ;
    q42:femurUberonCurie "UBERON:0000981" ;
    q42:pectoralisUberonCurie "UBERON:0002356" ;
    q42:latissimusUberonCurie "UBERON:0001498" ;
    q42:subsystemId "osteology_and_myology" ;
    q42:anatomyLayer "osteology_and_myology" ;
    ro:0002131 qualia:ornithorhynchus_anatinus ;
    q42:rigArchetype "ornithorhynchid_semiaquatic" ;
    q42:rigJointCount "24"^^xsd:integer ;
    q42:thoracicRibCount "17"^^xsd:integer ;
    q42:cervicalRibTrait "Retains unfused ancestral cervical ribs on C2-C7 vertebrae" ;
    q42:monotremeSkeletalTraits "Splayed premaxilla/maxilla bill rostrum framing cartilaginous bill plate, T-shaped interclavicle with coracoid-epicoracoid pectoral strut, broad flared humeral condyles for rotational swimming, paired epipubic bones on pelvis" ;
    q42:swimmingMyology "Hypertrophied latissimus dorsi, pectoralis, teres major, and triceps driving horizontal-to-ventral humeral rotation during alternating forelimb rowing, plus femoral abductor/rotator steering musculature" ;
    rdfs:label "Monotreme Osteology (17 Thoracic Ribs, T-Interclavicle, Epipubic Bones) & Rotational Swimmer Myology (24-Joint PGA Rig)"@en .

# ============================================================================
# 3. Biophysical, Morphometric, Allometric & Hydrodynamic Parameters
# ============================================================================

qualia:ornithorhynchus_anatinus
    q42:totalLengthMinM "0.39"^^xsd:decimal ;
    q42:totalLengthMaxM "0.60"^^xsd:decimal ;
    q42:typicalTotalLengthRangeM "0.45 to 0.55" ;
    q42:femaleTotalLengthMeanM "0.43"^^xsd:decimal ;
    q42:maleTotalLengthMeanM "0.50"^^xsd:decimal ;
    q42:bodyHeightWaterlineM "0.11"^^xsd:decimal ;
    q42:adultMassMinKg "0.70"^^xsd:decimal ;
    q42:adultMassMaxKg "3.00"^^xsd:decimal ;
    q42:adultFemaleMassRangeKg "0.70 to 1.70" ;
    q42:adultMaleMassRangeKg "1.20 to 3.00" ;
    q42:bmrWattsMin "1.90"^^xsd:decimal ;
    q42:bmrWattsMax "2.15"^^xsd:decimal ;
    q42:bodyTempC "32.0"^^xsd:decimal ;
    q42:bodyTempRangeC "31.0 to 35.0" ;
    q42:thermoregulation "endotherm_monotreme_hypometabolic_aquatic" ;
    q42:allometricBmrEquation "BMR(M) = 1.68 * M^0.75 [W]; at M=1.25 kg -> 1.99 W (~50-65% placental mean; conserved by 800-900 hairs/mm2 trapped air pelage)" ;
    q42:allometricBodyEquation "L_total = 0.44 * M^0.32 [m]; L_bill = 0.056 * M^0.28 [m]; L_tail = 0.118 * M^0.33 [m]" ;
    q42:allometricLimbEquation "L_humerus = 0.038 * M^0.33 [m]; L_radius = 0.036 * M^0.33 [m]; L_femur = 0.044 * M^0.33 [m]; A_foreweb = 0.0028 * M^0.66 [m^2]" ;
    q42:pipeModelHydrodynamicNotes "Streamlined body fineness ratio L/D ~ 5.2; sprawled humeral rowing sweeps at 1.5-2.6 Hz stroke frequency" ;
    q42:swimSpeedCruiseMs "0.55"^^xsd:decimal ;
    q42:swimSpeedBurstMs "1.35"^^xsd:decimal ;
    q42:diveDurationTypicalSec "30 to 140" ;
    q42:diveDurationMaxSec "600"^^xsd:integer ;
    q42:burrowTunnelLengthMinM "5.0"^^xsd:decimal ;
    q42:burrowTunnelLengthMaxM "20.0"^^xsd:decimal ;
    q42:activityCycle "crepuscular_nocturnal_cool_overcast_diurnal" ;
    q42:dietGuild "benthic_macroinvertebrate_electro_forager" ;
    q42:dailyFoodIntakeFraction "0.20 to 0.50 of body mass per 24 h" ;
    q42:reproductionStrategy "Oviparous monotreme: 1-3 leathery eggs (~16 x 14 mm) incubated ~10 d in grass/leaf-lined nesting burrow; 3-4 mo puggle burrow lactation from abdominal mammary patches (no teats)" ;
    sosa:callName "Soft low growl when disturbed in burrow or handled; normally silent underwater" ;
    sosa:callFundamentalHz "145.0"^^xsd:decimal ;
    envo:habitatStratum "freshwater_lotic_creek_river_pool_and_riparian_earth_bank" ;
    envo:elevationMinM "0"^^xsd:integer ;
    envo:elevationMaxM "1600"^^xsd:integer ;
    prov:wasDerivedFrom src:nsw-dpe-platypus , src:vic-wildlife-other-mammals , src:australian-platypus-conservancy .

