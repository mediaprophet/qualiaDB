# ============================================================================
# 5. InstanceState64 Ontogenetic Stages & 64-Byte Phenotype Parameter Bounds
# ============================================================================

inst64:ornithorhynchus_anatinus_layout a q42:InstanceState64Schema ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:byteSize "64"^^xsd:integer ;
    q42:fields "seed:u64, ontogenetic_age_norm:f32, height_scale:f32, site_vigor:f32, environmental_stress:f32[4], sex_dimorphism_flag:u8, calcaneal_spur_active:u8, web_deploy_01:f32, tail_fat_reserve_01:f32" ;
    q42:seedRange "0 to 18446744073709551615" ;
    q42:ontogeneticAgeNormRange "0.00 to 1.00" ;
    q42:heightScaleRange "0.18 to 1.15" ;
    q42:siteVigorRange "0.45 to 1.25" ;
    q42:environmentalStressRange "0.00 to 1.00 (drought_low_flow, siltation_turbidity, entanglement_stress, thermal_stress)" ;
    rdfs:label "InstanceState64 Phenotype Parameter Layout for Ornithorhynchus anatinus"@en .

stage:burrow_hatchling_puggle a q42:OntogeneticStage ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:stageId "burrow_hatchling_puggle" ;
    q42:ontogeneticAgeNormMin "0.00"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.20"^^xsd:decimal ;
    q42:heightScaleMin "0.18"^^xsd:decimal ;
    q42:heightScaleMax "0.52"^^xsd:decimal ;
    q42:massRangeKg "0.002 to 0.38" ;
    q42:independentLocomotion false ;
    q42:dentitionState "deciduous_molar_caps_present_pre_keratin_pad" ;
    rdfs:label "Burrow Hatchling Puggle (0-4 months, blind, hairless-to-velvet inside maternal nesting chamber)"@en .

stage:juvenile_emergent a q42:OntogeneticStage ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:stageId "juvenile_emergent" ;
    q42:ontogeneticAgeNormMin "0.20"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.48"^^xsd:decimal ;
    q42:heightScaleMin "0.52"^^xsd:decimal ;
    q42:heightScaleMax "0.84"^^xsd:decimal ;
    q42:massRangeKg "0.38 to 0.85" ;
    q42:independentLocomotion true ;
    q42:dentitionState "deciduous_molars_shedding_to_keratinous_pads" ;
    rdfs:label "Juvenile Emergent (4-12 months, first stream emergence, electro-foraging & dispersal)"@en .

stage:adult_female a q42:OntogeneticStage ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:stageId "adult_female" ;
    q42:ontogeneticAgeNormMin "0.48"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.82"^^xsd:decimal ;
    q42:heightScaleMax "0.98"^^xsd:decimal ;
    q42:massRangeKg "0.70 to 1.70" ;
    q42:totalLengthRangeM "0.39 to 0.49" ;
    q42:karyotype "2n=52 (10X)" ;
    q42:calcanealSpurPresent false ;
    rdfs:label "Adult Female (2n=52 10X, spur absent/regressed, nesting burrow excavator)"@en .

stage:spurred_adult_male a q42:OntogeneticStage ;
    q42:appliesTo qualia:ornithorhynchus_anatinus ;
    q42:stageId "spurred_adult_male" ;
    q42:ontogeneticAgeNormMin "0.48"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.92"^^xsd:decimal ;
    q42:heightScaleMax "1.15"^^xsd:decimal ;
    q42:massRangeKg "1.20 to 3.00" ;
    q42:totalLengthRangeM "0.45 to 0.60" ;
    q42:karyotype "2n=52 (X1Y1X2Y2X3Y3X4Y4X5Y5)" ;
    q42:calcanealSpurPresent true ;
    rdfs:label "Spurred Adult Male (2n=52 X1-5Y1-5, functional crural venom gland & calcaneal_venom_spur)"@en .

# ============================================================================
# 6. Ecological Interactions (Freshwater Benthic Electro-Forager & Riparian Corridor)
# ============================================================================

qualia:benthic_macroinvertebrates a dwc:Taxon ;
    rdfs:label "Freshwater Benthic Macroinvertebrates (Trichoptera, Ephemeroptera, Diptera larvae, Odonata nymphs, Oligochaeta)"@en .

qualia:paratya_australiensis a dwc:Taxon ;
    dwc:scientificName "Paratya australiensis Kemp, 1917" ;
    rdfs:label "Australian Glass Shrimp"@en .

qualia:cherax_destructor a dwc:Taxon ;
    dwc:scientificName "Cherax destructor Clark, 1936" ;
    rdfs:label "Common Yabby"@en .

qualia:eucalyptus_camaldulensis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus camaldulensis Dehnh." ;
    rdfs:label "River Red Gum (riparian bank stabilizer)"@en .

qualia:dicksonia_antarctica a dwc:Taxon ;
    dwc:scientificName "Dicksonia antarctica Labill." ;
    rdfs:label "Soft Tree Fern (cool-temperate gully riparian canopy)"@en .

qualia:ornithorhynchus_anatinus
    ro:0002470 qualia:benthic_macroinvertebrates ,
               qualia:paratya_australiensis ,
               qualia:cherax_destructor ;
    rorel:trophically_interacts_with qualia:benthic_macroinvertebrates ,
                                     qualia:paratya_australiensis ,
                                     qualia:cherax_destructor ;
    ro:0002303 envo:01000253 , envo:00000022 ;
    rorel:ecologically_related_to qualia:eucalyptus_camaldulensis ,
                                  qualia:dicksonia_antarctica ;
    q42:ecologicalFunction "Apex benthic macroinvertebrate electro-forager in permanent freshwater creeks and rivers along Eucalyptus camaldulensis floodplain and Dicksonia antarctica gully riparian corridors; indicator of stream bank stability, flow continuity, and benthic invertebrate diversity."@en ;
    rdfs:comment "Australian Platypus Conservancy, NSW DCCEEW, and Victorian Biodiversity Atlas document Ornithorhynchus anatinus across eastern Australian waterways from Northern Rivers / Clarence / Hunter through Snowy / Tumut / Murrumbidgee to the Yarra and Goulburn catchments."@en .

