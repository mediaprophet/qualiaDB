# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:eucalyptus_fastigata a dwc:Taxon ;
    dwc:scientificName "Eucalyptus fastigata H.Deane & Maiden" ;
    rdfs:label "Brown Barrel / Cut-tail"@en .

qualia:eucalyptus_obliqua a dwc:Taxon ;
    dwc:scientificName "Eucalyptus obliqua L'Her." ;
    rdfs:label "Messmate Stringybark"@en .

qualia:eucalyptus_delegatensis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus delegatensis R.T.Baker" ;
    rdfs:label "Alpine Ash"@en .

qualia:eucalyptus_regnans
    owl:differentFrom qualia:eucalyptus_fastigata ,
                      qualia:eucalyptus_obliqua ,
                      qualia:eucalyptus_delegatensis ;
    rdfs:comment "Taxonomic boundary: do not substitute E. fastigata (rough bark over entire trunk and branches, slightly domed capsule disc), E. obliqua (rough bark to branchlets, single axillary umbels, barrel-shaped fruit), or E. delegatensis (glaucous juvenile leaves, single axillary umbels)."@en .

