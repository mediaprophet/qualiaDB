# ============================================================================
# 6. Ecological Interactions (Sit-and-Wait Predator & Eucalypt Hollow Nester)
# ============================================================================

qualia:eucalyptus_camaldulensis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus camaldulensis Dehnh." ;
    rdfs:label "River Red Gum (Riparian Perch & Hollow-Bearing Nest Tree)"@en .

qualia:eucalyptus_melliodora a dwc:Taxon ;
    dwc:scientificName "Eucalyptus melliodora A.Cunn. ex Schauer" ;
    rdfs:label "Yellow Box (Box-Gum Woodland Perch & Hollow-Bearing Tree)"@en .

qualia:eucalyptus_dalrympleana a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dalrympleana Maiden subsp. dalrympleana" ;
    rdfs:label "Mountain White Gum (Montane Woodland Perch & Hollow-Bearing Tree)"@en .

qualia:nasutitermes_termitarium a dwc:Taxon ;
    dwc:scientificName "Nasutitermes spp." ;
    rdfs:label "Arboreal Termite Mound (Excavated Nest Chamber Substrate)"@en .

qualia:lampropholis_skinks a dwc:Taxon ;
    dwc:scientificName "Lampropholis / Egernia spp." ;
    rdfs:label "Woodland Scincid Lizards (Primary Vertebrate Prey)"@en .

qualia:cyclochila_cicadas a dwc:Taxon ;
    dwc:scientificName "Cyclochila / Psaltoda spp." ;
    rdfs:label "Australian Woodland Cicadas & Large Orthoptera (Invertebrate Prey)"@en .

qualia:pseudechis_snakes a dwc:Taxon ;
    dwc:scientificName "Pseudechis / Austrelaps spp." ;
    rdfs:label "Juvenile & Small Elapid Snakes (Secondary Vertebrate Prey)"@en .

qualia:dacelo_novaeguineae
    ro:0002470 qualia:lampropholis_skinks ,
               qualia:cyclochila_cicadas ,
               qualia:pseudechis_snakes ;
    rorel:trophically_interacts_with qualia:lampropholis_skinks ,
                                     qualia:cyclochila_cicadas ,
                                     qualia:pseudechis_snakes ;
    ro:0002503 qualia:eucalyptus_camaldulensis ,
               qualia:eucalyptus_melliodora ,
               qualia:eucalyptus_dalrympleana ,
               qualia:nasutitermes_termitarium ;
    ro:0002303 envo:01000220 ;
    q42:ecologicalFunction "Sit-and-wait apex woodland kingfisher regulating terrestrial reptile, large insect, and small snake populations; obligate secondary hollow-nester dependent on mature Eucalyptus camaldulensis, E. melliodora, and E. dalrympleana tree hollows and arboreal Nasutitermes termitaria."@en ;
    rdfs:comment "BirdLife Australia, NSW NPWS, and Australian Museum document permanent year-round family territories across open eucalypt forests and box-gum woodlands of South-Eastern Australia."@en .

