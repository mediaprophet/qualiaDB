    rdfs:label "Folded Avian Wings with Dark Primaries and White Basal Speculum"@en .

anat:wing_covert_azure_patch a uberon:0000019 , uberon:0000023 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0000019" ;
    q42:anatomyLayer "integument_structural_color" ;
    ro:0002131 anat:folded_wings_and_flight_feathers ;
