# --- Subsystem Group B: Avian Thorax, Folded Azure-Spangled Wings & Barred Rectrices ---

anat:avian_thorax_folded_azure_spangled_wings_and_barred_rectrices a uberon:0001130 , uberon:0000982 , uberon:0010364 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001130" ;
    q42:secondaryUberonCurie "UBERON:0000982" ;
    q42:tertiaryUberonCurie "UBERON:0010364" ;
    q42:anatomyLayer "osteology_and_plumage" ;
    ro:0002131 qualia:dacelo_novaeguineae ;
    q42:diagnosticFeature "Stocky upright perched torso; creamy-white to buff-white underparts with faint wavy brown flank barring; dark chocolate-brown mantle/scapulars; folded wings with iridescent azure/sky-blue lesser & median covert mottling; rufous-brown rump (blue center in adult males); broad 12-rectrix tail barred rufous-chestnut and dark brown with bright white terminal tips." ;
    rdfs:label "Avian Thorax, Azure-Spangled Folded Wings, and 12-Rectrix Barred Tail"@en ;
    prov:wasDerivedFrom src:birdlife-australia-laughing-kookaburra , src:australian-museum-laughing-kookaburra .

