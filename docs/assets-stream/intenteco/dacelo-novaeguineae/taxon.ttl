    q42:dietGuild "carnivorous_woodland_ambush_predator" ;
    q42:reproductionStrategy "Monogamous lifelong pair with cooperative family helpers (previous broods); 2-4 white eggs laid in unlined eucalypt hollow or arboreal Nasutitermes termitarium; incubation ~24-26 d; fledging ~33-39 d" ;
    sosa:callName "Territorial dawn/dusk laughing chorus (oo-oo-oo chuckle buildup -> ha-ha-ha-ha climax -> trailing oo-oo cadence)" ;
