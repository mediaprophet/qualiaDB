    q42:thermoregulation "heterothermic_endotherm" ;
    q42:allometricBmrEquation "BMR(M) = 3.49 * M^0.72 [W]; at M=0.333 kg -> ~1.12 W (201 mL O2/h resting phase; Buttemer et al. 2003)" ;
