    q42:anatomyLayer "osteology" ;
    ro:0002131 anat:heavy_bicolored_dagger_bill_and_crested_head ;
    q42:cranialForm "Broad, heavily ossified halcyonine neurocranium with reinforced craniofacial hinge for prey-bashing impact shock absorption" ;
    rdfs:label "Blocky Halcyonine Cranium and Reinforced Craniofacial Hinge"@en .

