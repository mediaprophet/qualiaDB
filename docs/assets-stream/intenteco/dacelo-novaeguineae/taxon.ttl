claim:largest-kingfisher-guild a rdf:Statement ;
    rdf:subject qualia:dacelo_novaeguineae ;
    rdf:predicate q42:functionalGuild ;
    rdf:object "terrestrial_halcyonine_sit_and_wait_woodland_predator" ;
    rdfs:comment "Dacelo novaeguineae is the world's largest kingfisher species (Alcedinidae: Halcyoninae), a cooperatively breeding, hollow- and termitarium-nesting sit-and-wait predator of Australian open eucalypt woodlands."@en .

claim:nomenclatural-toponym-note a rdf:Statement ;
    rdf:subject qualia:dacelo_novaeguineae ;
    rdf:predicate q42:nomenclatureAudit ;
    rdf:object "Alcedo novae-guineae Hermann, 1783" ;
    rdfs:comment "Hermann (1783) inadvertently assigned the specific epithet novaeguineae believing a specimen originated from New Guinea; the species is native to eastern mainland Australia (nominate D. n. novaeguineae) and introduced to Tasmania, SW Western Australia, and New Zealand."@en .

# ============================================================================
# 2. Anatomical Subsystems (UBERON: Cranium/Bill, Thorax/Wing/Tail, Feet/Syrinx)
# ============================================================================

# --- Subsystem Group A: Heavy Bicolored Dagger Bill & Crested Head ---

anat:heavy_bicolored_dagger_bill_and_crested_head a uberon:0000975 , uberon:0000168 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0000975" ;
    q42:secondaryUberonCurie "UBERON:0000168" ;
    q42:anatomyLayer "osteology_and_integument" ;
    ro:0002131 qualia:dacelo_novaeguineae ;
    q42:diagnosticFeature "Large blocky head with erectile crown crest feathers, dark brown median crown stripe, diagnostic dark chocolate-brown trans-ocular eye-stripe (loral_auricular_mask) and malar streak against creamy-white head/throat/nape collar, and massive 6.0-6.5 cm bicolored dagger bill." ;
    rdfs:label "Heavy Bicolored Dagger Bill and Crested Head (UBERON:0000975 / UBERON:0000168)"@en ;
    prov:wasDerivedFrom src:australian-museum-laughing-kookaburra , src:birdlife-australia-laughing-kookaburra .

