@prefix q42:    <urn:qualia:ontology:> .
@prefix qualia: <urn:qualia:taxon:> .

qualia:varanus_varius a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:varanus_varius> , <https://www.gbif.org/species/2470790> ;
    dct:identifier <urn:qualia:taxon:varanus_varius> , <did:q42:taxon:varanus_varius> ;
    rdfs:label "Lace Monitor (Goanna)"@en , "Varanus varius"@la ;
    dwc:kingdom "Animalia" ;
    dwc:family "Varanidae" ;
    dwc:scientificName "Varanus varius" ;
    dwc:vernacularName "Lace Monitor (Goanna)"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:2470790" ;
    dwc:taxonConceptID <https://biodiversity.org.au/afd/taxa/Varanus_varius> ;
    dcat:landingPage <https://github.com/intenteco/varanus-varius> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "1.85"^^xsd:decimal ;
    q42:hasAnimationClip "lateral_undulatory_sprawling_prowl" , "vomeronasal_tongue_flick_and_head_sweep" , "gular_basking_respiration_and_throat_puff" , "arboreal_bark_clinging_climb" ;
    q42:ecologicalRole "Eucalypt hollow trees, rocky outcrops, and woodland foraging territories." ;
    tk:custodial_country "Wiradjuri Country" , "Ngarigo Country" , "Ngunnawal Country" , "Yuin Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

qualia:varanus_variusShape a sh:NodeShape ;
    sh:targetNode qualia:varanus_varius ;
    sh:property [ sh:path dwc:scientificName ; sh:minCount 1 ] ;
    sh:property [ sh:path dwc:taxonID ; sh:minCount 1 ] .
