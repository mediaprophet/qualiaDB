claim:sole-extant-phascolarctidae a rdf:Statement ;
    rdf:subject qualia:phascolarctos_cinereus ;
    rdf:predicate q42:monotypicFamily ;
    rdf:object true ;
    rdfs:comment "Phascolarctos cinereus is the sole extant member of family Phascolarctidae (suborder Vombatiformes), sister to Vombatidae (wombats) with shared backward-opening pouch and vestigial tail."@en .

claim:latitudinal-cline-continuity a rdf:Statement ;
    rdf:subject qualia:phascolarctos_cinereus ;
    rdf:predicate q42:morphologicalCline ;
    rdf:object "Bergmann clinal mass and pelage insulation gradient across 28S to 39S"@en ;
    rdfs:comment "Southern (Victoria / Southern NSW) individuals exhibit greater adult mass (up to 14.0 kg) and longer, thicker cinnamon-grey dorsal pelage than smaller, silver-grey Northern Rivers / SEQ individuals; modeled continuously via InstanceState64 rather than split taxa."@en .

