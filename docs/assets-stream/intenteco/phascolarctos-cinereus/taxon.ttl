    rdfs:label "Descended Larynx and Velar Vocal Folds"@en .

# ============================================================================
# 3. Biophysical, Morphometric, Allometric & Kinematic Parameters
# ============================================================================

qualia:phascolarctos_cinereus
    q42:headBodyLengthMinM "0.60"^^xsd:decimal ;
    q42:headBodyLengthMaxM "0.85"^^xsd:decimal ;
    q42:adultMassMinKg "6.5"^^xsd:decimal ;
    q42:adultMassMaxKg "14.0"^^xsd:decimal ;
    q42:adultFemaleMassRangeKg "6.5 to 10.5 (cline: smaller northern NSW, larger VIC)" ;
    q42:adultMaleMassRangeKg "8.5 to 14.0 (cline: smaller northern NSW, larger VIC)" ;
    q42:bmrWatts "12.8"^^xsd:decimal ;
    q42:bmrRelativeToPlacentalPct "50.0"^^xsd:decimal ;
    q42:bodyTempC "36.1"^^xsd:decimal ;
    q42:thermoregulation "endotherm_energy_conserving" ;
    q42:allometricBmrEquation "BMR(M) = 2.02 * M^0.75 [W]; at M=11.7 kg -> 12.8 W (~50% of placental mammal mean)" ;
    q42:allometricSegmentEquation "L_forearm = 0.095 * M^0.33 [m]; L_caecum = 0.88 * M^0.35 [m] (~2.0 m); Mass(lat) = 4.2 + 0.25 * abs(lat_deg)" ;
    q42:restingDurationHoursPerDay "18.0 to 20.0" ;
    q42:restingPosture "Arboreal upright fork-resting posture wedged securely on cartilaginous rump pad with forelimbs draped or clasping branch" ;
    q42:climbingGait "Vertical trunk-bounding climbing gait (0.3-1.8 m/s) alternating schizodactylous forepaw anchors with synchronized hind-pes thrust" ;
    q42:terrestrialGait "Low quadrupedal bound/walk (0.5-2.8 m/s) between isolated feed trees" ;
    q42:activityCycle "nocturnal_crepuscular_arboreal_foraging" ;
    q42:dietGuild "obligate_eucalypt_folivore" ;
    q42:dailyLeafIntakeKg "0.40 to 0.70" ;
    q42:reproductionStrategy "Seasonal spring-summer breeding; 34-36 day gestation; 6-7 month pouch residency followed by 5-6 month back-riding" ;
    sosa:callName "Male territorial inhalation/exhalation snore-bellow via velar vocal folds; female/joey high-pitched alarm squeak" ;
    sosa:callFundamentalHzMin "25.0"^^xsd:decimal ;
    sosa:callFundamentalHzMax "60.0"^^xsd:decimal ;
    sosa:callFundamentalHz "32.0"^^xsd:decimal ;
    envo:habitatStratum "arboreal_eucalypt_canopy" ;
    envo:elevationMinM "0"^^xsd:integer ;
    envo:elevationMaxM "1300"^^xsd:integer ;
    prov:wasDerivedFrom src:sprat-85104 , src:nsw-bionet-10616 , src:vic-deeca-koalas .

# ============================================================================
# 4. Joint Range-of-Motion (ROM) & Injury Threshold Assertions (Radians)
# ============================================================================

rom:shoulder a q42:JointROM ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:romJoint "shoulder" ;
    q42:anatomicalTarget anat:pectoral_girdle_clavicle , anat:climbing_forelimb_latissimus_myology ;
    q42:primaryAxis "overhead_reach_and_trunk_embrace" ;
    q42:healthyMinRad "-0.70"^^xsd:decimal ;
    q42:healthyMaxRad "2.25"^^xsd:decimal ;
    q42:abductionMinRad "-0.35"^^xsd:decimal ;
    q42:abductionMaxRad "1.55"^^xsd:decimal ;
    q42:injuryThresholdRad "2.48"^^xsd:decimal ;
    q42:obligatePostInjuryBehavior "q42:obligateForepawProtectiveGuarding" ;
