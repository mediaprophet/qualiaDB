# ============================================================================
# 5. InstanceState64 Ontogenetic Stages & 64-Byte Phenotype Parameter Bounds
# ============================================================================

inst64:phascolarctos_cinereus_layout a q42:InstanceState64Schema ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:byteSize "64"^^xsd:integer ;
    q42:fields "seed:u64, ontogenetic_age_norm:f32, height_scale:f32, site_vigor:f32, environmental_stress:f32[4], sex_dimorphism_flag:u8, pouch_occupancy_flag:u8, latitudinal_cline_01:f32, coat_cinnamon_shift:f32" ;
    q42:seedRange "0 to 18446744073709551615" ;
    q42:ontogeneticAgeNormRange "0.00 to 1.00" ;
    q42:heightScaleRange "0.10 to 1.18" ;
    q42:siteVigorRange "0.40 to 1.25" ;
    q42:environmentalStressRange "0.00 to 1.00 (heatwave_dehydration, chlamydia_conjunctivitis_index, wildfire_smoke_char, habitat_fragmentation)" ;
    q42:latitudinalClineRange "0.00 (Northern Rivers silver-grey) to 1.00 (Victoria / Southern NSW thick cinnamon-grey)" ;
    rdfs:label "InstanceState64 Phenotype Parameter Layout for Phascolarctos cinereus"@en .

stage:pouch_joey a q42:OntogeneticStage ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:stageId "pouch_joey" ;
    q42:ontogeneticAgeNormMin "0.00"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.16"^^xsd:decimal ;
    q42:heightScaleMin "0.08"^^xsd:decimal ;
    q42:heightScaleMax "0.30"^^xsd:decimal ;
    q42:massRangeKg "0.0005 to 0.50" ;
    q42:independentLocomotion false ;
    rdfs:label "Pouch Joey (0-6.5 months, backward-opening pouch & pap transition)"@en .

stage:back_riding_juvenile a q42:OntogeneticStage ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:stageId "back_riding_juvenile" ;
    q42:ontogeneticAgeNormMin "0.16"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.36"^^xsd:decimal ;
    q42:heightScaleMin "0.30"^^xsd:decimal ;
    q42:heightScaleMax "0.58"^^xsd:decimal ;
    q42:massRangeKg "0.50 to 2.8" ;
    q42:independentLocomotion true ;
    rdfs:label "Back-Riding Juvenile (6.5-12 months, maternal clinging & leaf weaning)"@en .

stage:subadult_disperser a q42:OntogeneticStage ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:stageId "subadult_disperser" ;
    q42:ontogeneticAgeNormMin "0.36"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.60"^^xsd:decimal ;
    q42:heightScaleMin "0.58"^^xsd:decimal ;
    q42:heightScaleMax "0.84"^^xsd:decimal ;
    q42:massRangeKg "2.8 to 6.4" ;
    q42:independentLocomotion true ;
    rdfs:label "Subadult Disperser (12-24 months, terrestrial tree-to-tree dispersal)"@en .

stage:adult_female a q42:OntogeneticStage ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:stageId "adult_female" ;
    q42:ontogeneticAgeNormMin "0.60"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.84"^^xsd:decimal ;
    q42:heightScaleMax "1.02"^^xsd:decimal ;
    q42:massRangeKg "6.5 to 10.5" ;
    q42:headBodyLengthMinM "0.60"^^xsd:decimal ;
    q42:headBodyLengthMaxM "0.75"^^xsd:decimal ;
    q42:supportsPouchOccupancy true ;
    q42:sternalScentGlandActive false ;
    rdfs:label "Adult Female (backward-opening pouch, narrower skull, lacking active sternal gland)"@en .

stage:adult_male a q42:OntogeneticStage ;
    q42:appliesTo qualia:phascolarctos_cinereus ;
    q42:stageId "adult_male" ;
    q42:ontogeneticAgeNormMin "0.60"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.92"^^xsd:decimal ;
    q42:heightScaleMax "1.18"^^xsd:decimal ;
    q42:massRangeKg "8.5 to 14.0" ;
    q42:headBodyLengthMinM "0.70"^^xsd:decimal ;
    q42:headBodyLengthMaxM "0.85"^^xsd:decimal ;
    q42:supportsPouchOccupancy false ;
    q42:sternalScentGlandActive true ;
    q42:velarBellowCapable true ;
    rdfs:label "Adult Male (broader cranium, active dark sternal scent gland, 25-60 Hz bellow)"@en .

# ============================================================================
# 6. Ecological Interactions (Obligate Eucalypt Folivory & Canopy Stratum)
# ============================================================================

qualia:eucalyptus_camaldulensis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus camaldulensis Dehnh." ;
    rdfs:label "River Red Gum"@en .

qualia:eucalyptus_viminalis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus viminalis Labill." ;
    rdfs:label "Manna Gum / Ribbon Gum"@en .

qualia:eucalyptus_tereticornis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus tereticornis Sm." ;
    rdfs:label "Forest Red Gum"@en .

qualia:eucalyptus_dalrympleana a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dalrympleana Maiden" ;
    rdfs:label "Mountain White Gum"@en .

qualia:eucalyptus_punctata a dwc:Taxon ;
    dwc:scientificName "Eucalyptus punctata DC." ;
    rdfs:label "Grey Gum"@en .

qualia:eucalyptus_globulus a dwc:Taxon ;
    dwc:scientificName "Eucalyptus globulus Labill." ;
    rdfs:label "Southern Blue Gum"@en .

qualia:eucalyptus_ovata a dwc:Taxon ;
    dwc:scientificName "Eucalyptus ovata Labill." ;
    rdfs:label "Swamp Gum"@en .

qualia:phascolarctos_cinereus
    ro:0002470 qualia:eucalyptus_camaldulensis ,
               qualia:eucalyptus_viminalis ,
               qualia:eucalyptus_tereticornis ,
               qualia:eucalyptus_dalrympleana ,
               qualia:eucalyptus_punctata ,
               qualia:eucalyptus_globulus ,
               qualia:eucalyptus_ovata ;
    rorel:trophically_interacts_with qualia:eucalyptus_camaldulensis ,
                                     qualia:eucalyptus_viminalis ,
                                     qualia:eucalyptus_tereticornis ,
                                     qualia:eucalyptus_dalrympleana ,
                                     qualia:eucalyptus_punctata ,
                                     qualia:eucalyptus_globulus ,
                                     qualia:eucalyptus_ovata ;
    ro:0002303 envo:01000220 ;
    q42:ecologicalFunction "Specialized arboreal eucalypt folivore relying on high-foliar-nitrogen, low-FPC Eucalyptus trees for both hydration and nutrition across SE Australian sclerophyll forests and riparian corridors."@en ;
    rdfs:comment "Northern populations (QLD, NSW, ACT) are EPBC Endangered due to clearing, drought, wildfire, and Chlamydia pecorum; southern Victorian populations exhibit localized high densities on manna gum (E. viminalis) and swamp gum (E. ovata)."@en .

