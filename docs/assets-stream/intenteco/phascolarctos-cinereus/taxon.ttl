    q42:caecumLengthM "2.0"^^xsd:decimal ;
    q42:hepaticDetoxification "Expanded cytochrome P450 CYP2C monooxygenase gene family in liver (UBERON:0002107) clearing eucalypt monoterpenes (1,8-cineole) and formylated phloroglucinol compounds (FPCs)" ;
