@prefix q42:    <urn:qualia:ontology:> .
@prefix qualia: <urn:qualia:taxon:> .

qualia:xanthorrhoea_australis a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:xanthorrhoea_australis> , <https://www.gbif.org/species/2779855> ;
    dct:identifier <urn:qualia:taxon:xanthorrhoea_australis> , <did:q42:taxon:xanthorrhoea_australis> ;
    rdfs:label "Austral Grass Tree"@en , "Xanthorrhoea australis"@la ;
    dwc:kingdom "Plantae" ;
    dwc:family "Asphodelaceae" ;
    dwc:scientificName "Xanthorrhoea australis" ;
    dwc:vernacularName "Austral Grass Tree"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:2779855" ;
    dwc:taxonConceptID <https://id.biodiversity.org.au/name/apni/69614> ;
    dcat:landingPage <https://github.com/intenteco/xanthorrhoea-australis> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "1.1"^^xsd:decimal ;
    q42:hasAnimationClip "crown_fountain_wind_ripple" , "post_fire_epicormic_flush" , "nectar_spike_helical_anthesis" , "skirt_thatch_rustle" ;
    q42:ecologicalRole "Sclerophyll eucalypt woodlands, rocky slopes, and fire-adapted ridges." ;
    tk:custodial_country "Wiradjuri Country" , "Ngarigo Country" , "Ngunnawal Country" , "Wurundjeri Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

qualia:xanthorrhoea_australisShape a sh:NodeShape ;
    sh:targetNode qualia:xanthorrhoea_australis ;
    sh:property [ sh:path dwc:scientificName ; sh:minCount 1 ] ;
    sh:property [ sh:path dwc:taxonID ; sh:minCount 1 ] .
