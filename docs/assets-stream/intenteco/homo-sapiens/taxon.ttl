# --- IK Chains & Seated Driver Posture ---

ik:leg_l a q42:IkChain ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:solver "two_bone_ik" ;
    q42:rootJoint skl2:hip_l ;
    q42:midJoint skl2:knee_l ;
    q42:endJoint skl2:ankle_l ;
    q42:upperLengthM "0.4301"^^xsd:decimal ;
    q42:lowerLengthM "0.4105"^^xsd:decimal .

ik:leg_r a q42:IkChain ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:solver "two_bone_ik" ;
    q42:rootJoint skl2:hip_r ;
    q42:midJoint skl2:knee_r ;
    q42:endJoint skl2:ankle_r ;
    q42:upperLengthM "0.4301"^^xsd:decimal ;
    q42:lowerLengthM "0.4105"^^xsd:decimal .

ik:arm_l a q42:IkChain ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:solver "two_bone_ik" ;
    q42:rootJoint skl2:shoulder_l ;
    q42:midJoint skl2:elbow_l ;
    q42:endJoint skl2:wrist_l ;
    q42:upperLengthM "0.2650"^^xsd:decimal ;
    q42:lowerLengthM "0.2250"^^xsd:decimal .

ik:arm_r a q42:IkChain ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:solver "two_bone_ik" ;
    q42:rootJoint skl2:shoulder_r ;
    q42:midJoint skl2:elbow_r ;
    q42:endJoint skl2:wrist_r ;
    q42:upperLengthM "0.2650"^^xsd:decimal ;
    q42:lowerLengthM "0.2250"^^xsd:decimal .

rom:seated_driver a q42:PostureSpecification ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:hipFlexionDeg "95.0"^^xsd:decimal ;
    q42:kneeFlexionDeg "65.0"^^xsd:decimal ;
    q42:comSeatedM "0.78"^^xsd:decimal ;
    q42:steeringWheelGrip "10_and_2_oclock_rim_power_grasp" ;
    rdfs:label "Seated Driver Posture (Hip ~95 deg, Knee ~65 deg, Hands on Steering Wheel Rim)"@en .

# ============================================================================
# 4. Allometric Scaling, InstanceState64 & Ontogenetic Stages
# ============================================================================

qualia:homo_sapiens
    q42:bmrWatts "75.6"^^xsd:decimal ;
    q42:bodyTempC "37.0"^^xsd:decimal ;
    q42:allometricBmrEquation "BMR(M) = 3.05 * M^0.75 [W]; at M=72.0 kg -> 75.6 W" ;
    q42:allometricSegmentEquation "H_stature = 1.74 m; L_femur = 0.247 * H; L_tibia = 0.236 * H; L_humerus = 0.152 * H; L_forearm = 0.129 * H; ArmSpan = 1.00 * H" ;
    q42:locomotorModes "bipedal_walk (1.35 m/s), run (3.5-8.0 m/s), seated_driver, specimen_inspect" .

inst64:homo_sapiens_layout a q42:InstanceState64Schema ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:byteSize "64"^^xsd:integer ;
    q42:fields "seed:u64, ontogenetic_age_norm:f32, height_scale:f32, site_vigor:f32, environmental_stress:f32[4], sex_dimorphism_flag:u8, posture_mode_flag:u8, reserved_flags:u16, heart_rate_bpm:f32, respiration_hz:f32, muscle_tone_01:f32, melanin_eumelanin_01:f32, adiposity_scale:f32, neural_arousal_01:f32" ;
    q42:ontogeneticAgeNormRange "0.00 to 1.00" ;
    q42:heightScaleRange "0.30 to 1.18" ;
    q42:siteVigorRange "0.60 to 1.25" ;
    q42:environmentalStressRange "0.00 to 1.00" .

stage:infant a q42:OntogeneticStage ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:stageId "infant" ;
    q42:ontogeneticAgeNormMin "0.00"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.04"^^xsd:decimal ;
    q42:heightScaleMin "0.30"^^xsd:decimal ;
    q42:heightScaleMax "0.52"^^xsd:decimal .

stage:child a q42:OntogeneticStage ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:stageId "child" ;
    q42:ontogeneticAgeNormMin "0.04"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.16"^^xsd:decimal ;
    q42:heightScaleMin "0.52"^^xsd:decimal ;
    q42:heightScaleMax "0.85"^^xsd:decimal .

stage:adolescent a q42:OntogeneticStage ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:stageId "adolescent" ;
    q42:ontogeneticAgeNormMin "0.16"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.26"^^xsd:decimal ;
    q42:heightScaleMin "0.85"^^xsd:decimal ;
    q42:heightScaleMax "0.99"^^xsd:decimal .

stage:adult a q42:OntogeneticStage ;
    q42:appliesTo qualia:homo_sapiens ;
    q42:stageId "adult" ;
    q42:ontogeneticAgeNormMin "0.26"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.80"^^xsd:decimal ;
    q42:heightScaleMin "0.90"^^xsd:decimal ;
    q42:heightScaleMax "1.18"^^xsd:decimal ;
