# 1. Taxon Concept & Authoritative Identifiers
# ============================================================================

qualia:homo_sapiens a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs q42taxon:homo-sapiens , q42taxon:homo_sapiens ;
    dct:identifier <urn:qualia:taxon:homo_sapiens> ,
                   <did:q42:taxon:homo-sapiens> ,
                   <did:q42:taxon:homo_sapiens> ;
    rdfs:label "Human (Homo sapiens)"@en ;
    dwc:scientificName "Homo sapiens Linnaeus, 1758" ;
    dwc:scientificNameAuthorship "Linnaeus, 1758" ;
    dwc:kingdom "Animalia" ;
    dwc:phylum "Chordata" ;
    dwc:class "Mammalia" ;
    dwc:order "Primates" ;
    dwc:family "Hominidae" ;
    dwc:genus "Homo" ;
    dwc:specificEpithet "sapiens" ;
    dwc:taxonRank "species" ;
    dwc:taxonomicStatus "accepted" ;
    dwc:vernacularName "Human"@en ;
    dwc:taxonID "GBIF:2436436" ;
    q42:gbifSpeciesKey "2436436"^^xsd:integer ;
    q42:ncbiTaxon <http://purl.obolibrary.org/obo/NCBITaxon_9606> ;
    q42:karyotype "2n=46 (XX/XY)" ;
    q42:iucnStatus "LC" ;
    dcat:landingPage <https://github.com/intenteco/homo-sapiens> ;
    rdfs:seeAlso <https://www.gbif.org/species/2436436> ,
                 <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/9606/> ,
                 <https://bie.ala.org.au/species/https://biodiversity.org.au/afd/taxa/07c5957e-f538-4c56-983a-029aa96d76f8> ,
                 <https://www.iso.org/standard/65246.html> ;
    prov:wasDerivedFrom src:fma-ontology ,
                        src:uberon-ontology ,
                        src:gbif-2436436 ,
                        src:ncbi-9606 ,
                        src:ala-homo-sapiens ,
                        src:iso-7250-1 ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:commonsLicence "SPC" ;
    q42:skl2JointCount "28"^^xsd:integer ;
    q42:skl2Archetype "human_bipedal_skl2_28" ;
    tk:custodial_country country:bundjalung_country ,
                         country:gumbaynggirr_country ,
                         country:gadigal_country ,
                         country:dharug_country ,
                         country:yuin_country ,
                         country:ngarigo_country ,
                         country:walgalu_country ,
                         country:wiradjuri_country ,
                         country:gunaikurnai_country ,
                         country:wurundjeri_country ,
                         country:boonwurrung_country ,
                         country:wadawurrung_country .

q42taxon:homo-sapiens a dwc:Taxon ;
    dct:identifier <did:q42:taxon:homo-sapiens> ;
    owl:sameAs qualia:homo_sapiens ;
    rdfs:label "Homo sapiens Q42 DID Taxon Locator"@en .

