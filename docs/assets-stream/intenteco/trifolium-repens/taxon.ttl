    tk:custodial_country "Dharawal Country (NSW)" ;
    q42:recordedOnCountry "Dharawal Country (NSW)" ;
    rdfs:seeAlso <https://id.biodiversity.org.au/node/apni/2909697> , <https://www.gbif.org/species/5358748> , <https://bie.ala.org.au/search?q=Trifolium+repens> , <https://vicflora.rbg.vic.gov.au/flora/search?q=Trifolium+repens> , <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?page=nswfl&lvl=sp&name=Trifolium+repens> ;
