<did:q42:taxon:acacia_pycnantha> a dwc:Taxon ;
    owl:sameAs qualia:acacia_pycnantha ;
    rdfs:label "DID Q42 Locator — Acacia pycnantha Benth."@en .

# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:acacia_pedina a dwc:Taxon ;
    dwc:scientificName "Acacia pedina Kodela & Tame" ;
    rdfs:label "Coastal Golden Wattle"@en .

qualia:acacia_penninervis a dwc:Taxon ;
    dwc:scientificName "Acacia penninervis Sieber ex DC." ;
    rdfs:label "Mountain Hickory"@en .

qualia:acacia_saligna a dwc:Taxon ;
    dwc:scientificName "Acacia saligna (Labill.) H.L.Wendl." ;
    rdfs:label "Golden Wreath Wattle"@en .

qualia:acacia_retinodes a dwc:Taxon ;
    dwc:scientificName "Acacia retinodes Schltdl." ;
    rdfs:label "Wirilda / Swamp Wattle"@en .

qualia:acacia_pycnantha
    owl:differentFrom qualia:acacia_pedina ,
                      qualia:acacia_penninervis ,
                      qualia:acacia_saligna ,
                      qualia:acacia_retinodes ;
    rdfs:comment "Taxonomic boundary: do not substitute A. pedina (shorter, non-falcate adult phyllodes and fewer-flowered heads on shorter racemes), A. penninervis (fewer flowers per head and wider pods 10-20 mm), A. saligna (WA origin, drooping willow-like habit, larger solitary/few-headed racemes and narrower linear phyllodes), or A. retinodes (narrower linear-oblanceolate phyllodes and much smaller pale yellow flower heads)."@en .

