# 6. ECOLOGICAL INTERACTIONS (RO:*)
# ==============================================================================

qualia:bradyrhizobium_rhizobia a dwc:Taxon ;
    dwc:scientificName "Bradyrhizobium spp." ;
    rdfs:label "Nitrogen-Fixing Root-Nodule Rhizobial Symbiont"@en .

qualia:myrmecochorous_ants a dwc:Taxon ;
    dwc:scientificName "Formicidae (Iridomyrmex / Rhytidoponera / Pheidole spp.)" ;
    rdfs:label "Myrmecochorous Seed-Dispersing & Extrafloral-Nectary Mutualist Ants"@en .

qualia:meliphagidae_honeyeaters a dwc:Taxon ;
    dwc:scientificName "Meliphagidae & Zosteropidae (Honeyeaters & Silvereyes)" ;
    rdfs:label "Nectarivorous & Insectivorous Avian Pollinators"@en .

qualia:eucalyptus_sclerophyll_associates a dwc:Taxon ;
    rdfs:label "South-Eastern Australian Dry Sclerophyll Eucalyptus & Heath Guild"@en .

# RO:0002444 = symbiont of / mutualist; RO:0002434 = interacts with;
# RO:0002081 = co-occurs with / overlapping niche
qualia:acacia_pycnantha
    ro:0002444 qualia:bradyrhizobium_rhizobia ;
    ro:0002434 qualia:myrmecochorous_ants ,
               qualia:meliphagidae_honeyeaters ;
    ro:0002081 qualia:eucalyptus_sclerophyll_associates ;
    q42:fireRegenerationStrategy "obligate_seeder_soil_seedbank_heat_scarification" ;
    q42:biome envo:01000221 , envo:00000446 , envo:01000219 ;
    rdfs:comment "Keystone nitrogen-fixing understorey tree/shrub of South-Eastern Australian dry sclerophyll forests, woodlands, and heathlands. Bradyrhizobium root-nodule symbiosis fixes atmospheric N2 into nutrient-poor soils; phyllode extrafloral nectary glands attract ants (defending foliage) and honeyeaters/silvereyes (transferring pollen across golden capitula); hard black seeds with fleshy elaiosomes undergo myrmecochorous burial by ants; bushfire heat pulses scarify the dormant soil seedbank to trigger synchronous post-fire recruitment."@en ;
    prov:wasDerivedFrom src:foa , src:vicflora , src:plantnet , src:ala .

