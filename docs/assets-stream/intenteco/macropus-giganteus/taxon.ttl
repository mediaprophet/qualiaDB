# 2. Anatomical Subsystems (UBERON: Cranial, Axial/Pelvic, Limb/Tendon & Pelage)
# ============================================================================

# --- Primary Diagnostic Anatomical Systems ---

anat:cranial_and_facial_system a uberon:0000975 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0000975" ;
    q42:anatomyLayer "osteology_and_integument" ;
    ro:0002131 qualia:macropus_giganteus ;
    q42:cranialProfile "Elongated, finely sculpted grazing macropodid skull with arched cranial vault, distinct forehead stop, and long slender tapering muzzle" ;
    q42:diagnosticRhinarium "Finely haired rhinarium between the nostrils with only a narrow bare black rim around each nostril (UBERON:0001756)" ;
    q42:ocularMorphology "Large dark liquid eyes set beneath pronounced supraorbital ridges (UBERON:0000970)" ;
    q42:pinnaCurie "UBERON:0001757" ;
    q42:pinnaForm "Tall, mobile, oval-pointed cupped external pinnae with pale grey-white inner fringe and dark-rimmed apex" ;
    rdfs:label "Cranial and Facial System (Finely Haired Rhinarium & Tall Cupped Pinnae)"@en ;
    prov:wasDerivedFrom src:australian-museum-eastern-grey .

anat:external_pinnae a uberon:0001757 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001757" ;
