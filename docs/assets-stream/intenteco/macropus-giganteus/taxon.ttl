    q42:heightScaleMax "0.84"^^xsd:decimal ;
    q42:massRangeKg "14.0 to 26.0" ;
    q42:independentLocomotion true ;
    rdfs:label "Subadult Flyer (18-30 months, slender fast-moving young kangaroo)"@en .

stage:adult_doe a q42:OntogeneticStage ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:stageId "adult_doe" ;
    q42:ontogeneticAgeNormMin "0.65"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.80"^^xsd:decimal ;
    q42:heightScaleMax "0.96"^^xsd:decimal ;
    q42:massRangeKg "24.0 to 38.0" ;
    q42:standingHeightMinM "1.30"^^xsd:decimal ;
    q42:standingHeightMaxM "1.60"^^xsd:decimal ;
    q42:karyotype "2n=16 (XX)" ;
    q42:supportsPouchOccupancy true ;
    rdfs:label "Adult Doe (2n=16 XX, forward-opening marsupium)"@en .

stage:alpha_boomer_buck a q42:OntogeneticStage ;
