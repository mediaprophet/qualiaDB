# ============================================================================
# 6. Ecological Interactions (Grassy Woodland Grazer & Habitat Associations)
# ============================================================================

qualia:poa_labillardierei a dwc:Taxon ;
    dwc:scientificName "Poa labillardierei Steud." ;
    rdfs:label "Common Tussock-Grass"@en .

qualia:themeda_triandra a dwc:Taxon ;
    dwc:scientificName "Themeda triandra Forssk." ;
    rdfs:label "Kangaroo Grass"@en .

qualia:microlaena_stipoides a dwc:Taxon ;
    dwc:scientificName "Microlaena stipoides (Labill.) R.Br." ;
    rdfs:label "Weeping Grass"@en .

qualia:eucalyptus_melliodora a dwc:Taxon ;
    dwc:scientificName "Eucalyptus melliodora A.Cunn. ex Schauer" ;
    rdfs:label "Yellow Box"@en .

qualia:eucalyptus_camaldulensis a dwc:Taxon ;
    dwc:scientificName "Eucalyptus camaldulensis Dehnh." ;
    rdfs:label "River Red Gum"@en .

qualia:macropus_giganteus
    ro:0002470 qualia:poa_labillardierei ,
               qualia:themeda_triandra ,
               qualia:microlaena_stipoides ;
    rorel:trophically_interacts_with qualia:poa_labillardierei ,
                                     qualia:themeda_triandra ,
                                     qualia:microlaena_stipoides ;
    ro:0002303 envo:01000220 ,
               qualia:eucalyptus_melliodora ,
               qualia:eucalyptus_camaldulensis ;
    q42:ecologicalFunction "Dominant social native grazing herbivore of South-Eastern Australian Eucalyptus melliodora grassy box-gum woodlands, E. camaldulensis floodplain woodlands, and open sclerophyll forests, maintaining herbaceous sward heterogeneity and nutrient cycling."@en ;
    rdfs:comment "Forms cohesive social mobs foraging crepuscularly and nocturnally across open grassy woodland glades and sheltering in adjacent eucalypt woodland cover during midday heat."@en .

