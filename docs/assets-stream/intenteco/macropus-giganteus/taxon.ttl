    q42:lengthMinM "0.95"^^xsd:decimal ;
    q42:lengthMaxM "1.15"^^xsd:decimal ;
    q42:tailColoration "Silver-grey dorsal coat grading into a dark charcoal-tipped distal third" ;
    q42:biomechanicalRole "Dynamic angular-momentum counterweight during high-speed bipedal hopping and load-bearing fifth propulsive strut during slow pentapedal grazing" ;
    rdfs:label "Massive Muscular Tapered Pentapedal & Counterweight Tail"@en .

anat:forelimb_and_elastic_tendon_hindlimb_system a uberon:0002102 , uberon:0002103 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0002102" ;
    q42:secondaryUberonCurie "UBERON:0002103" ;
    q42:anatomyLayer "osteology_and_myology" ;
    ro:0002131 qualia:macropus_giganteus ;
    q42:forelimbFunction "5-clawed manus for pelage grooming, agonistic male boxing, pentapedal weight support, and evaporative thermoregulatory forearm-licking over dense superficial vascular plexus" ;
    q42:hindlimbElasticTendons "Hypertrophied gluteal, quadriceps, and gastrocnemius/plantaris complex coupled to long elastic Achilles and plantaris tendons storing and returning strain energy" ;
