# ============================================================================
# 5. InstanceState64 Ontogenetic Stages & 64-Byte Phenotype Parameter Bounds
# ============================================================================

inst64:macropus_giganteus_layout a q42:InstanceState64Schema ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:byteSize "64"^^xsd:integer ;
    q42:fields "seed:u64, ontogenetic_age_norm:f32, height_scale:f32, site_vigor:f32, environmental_stress:f32[4], sex_dimorphism_flag:u8, pouch_occupancy_flag:u8, pelage_silver_shift:f32, forelimb_hypertrophy_01:f32" ;
    q42:seedRange "0 to 18446744073709551615" ;
    q42:ontogeneticAgeNormRange "0.00 to 1.00" ;
    q42:heightScaleRange "0.10 to 1.25" ;
    q42:siteVigorRange "0.45 to 1.25" ;
    q42:environmentalStressRange "0.00 to 1.00" ;
    rdfs:label "InstanceState64 Phenotype Parameter Layout for Macropus giganteus"@en .

stage:pouch_joey a q42:OntogeneticStage ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:stageId "pouch_joey" ;
    q42:ontogeneticAgeNormMin "0.00"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.22"^^xsd:decimal ;
    q42:heightScaleMin "0.10"^^xsd:decimal ;
    q42:heightScaleMax "0.32"^^xsd:decimal ;
    q42:massRangeKg "0.0008 to 4.5" ;
    q42:independentLocomotion false ;
    rdfs:label "Pouch Joey (0-9 months, inside forward-opening marsupium)"@en .

stage:young_at_foot a q42:OntogeneticStage ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:stageId "young_at_foot" ;
    q42:ontogeneticAgeNormMin "0.22"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.42"^^xsd:decimal ;
    q42:heightScaleMin "0.32"^^xsd:decimal ;
    q42:heightScaleMax "0.58"^^xsd:decimal ;
    q42:massRangeKg "4.5 to 14.0" ;
    q42:independentLocomotion true ;
    rdfs:label "Young-at-Foot (9-18 months, grazing beside doe while nursing)"@en .

stage:subadult_flyer a q42:OntogeneticStage ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:stageId "subadult_flyer" ;
    q42:ontogeneticAgeNormMin "0.42"^^xsd:decimal ;
