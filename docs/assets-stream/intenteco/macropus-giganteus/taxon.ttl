# ============================================================================
# 3. Biophysical, Morphometric, Allometric & Kinematic Parameters
# ============================================================================

qualia:macropus_giganteus
    q42:headBodyLengthMinM "0.95"^^xsd:decimal ;
    q42:headBodyLengthMaxM "1.50"^^xsd:decimal ;
    q42:tailLengthMinM "0.95"^^xsd:decimal ;
    q42:tailLengthMaxM "1.15"^^xsd:decimal ;
    q42:erectStandingHeightMaxM "2.10"^^xsd:decimal ;
    q42:adultFemaleStandingHeightRangeM "1.30 to 1.60" ;
    q42:adultMaleStandingHeightRangeM "1.60 to 2.10" ;
    q42:adultMassMinKg "24.0"^^xsd:decimal ;
    q42:adultMassMaxKg "85.0"^^xsd:decimal ;
    q42:adultFemaleMassRangeKg "24.0 to 38.0" ;
    q42:adultMaleMassRangeKg "50.0 to 85.0" ;
    q42:bmrWatts "49.7"^^xsd:decimal ;
    q42:bodyTempC "36.2"^^xsd:decimal ;
    q42:thermoregulation "endotherm_forearm_evaporative_licking" ;
    q42:allometricBmrEquation "BMR(M) = 2.86 * M^0.75 [W]; at M=45.0 kg -> 49.7 W; at M=66.0 kg -> 66.2 W (marsupial scaling)" ;
    q42:allometricSegmentEquation "L_pes = 0.112 * M^0.34 [m]; L_tibia = 0.155 * M^0.35 [m]; L_femur = 0.089 * M^0.33 [m]; L_tail = 0.305 * M^0.32 [m]" ;
    q42:pipeModelMuscleAreaScaling "A_muscle_tendon ~ M^0.78 (handling peak saltatorial landing impulses at high hop velocities)" ;
    q42:pentapedalGait "Slow pentapedal grazing progression (0.4-1.2 m/s): weight supported on forelimbs and muscular tail while hindlimbs swing forward in unison" ;
    q42:saltatorialGait "High-efficiency bipedal elastic-recoil hop (5.0-17.5 m/s; cruising 6.5-10.0 m/s with >=54% Achilles/plantaris elastic energy recovery)" ;
    q42:activityCycle "crepuscular_nocturnal_early_morning_grazing" ;
    q42:dietGuild "obligate_grass_grazing_macropodid" ;
    q42:reproductionStrategy "Seasonal/facultative embryonic diapause, ~36 d gestation, ~9-10 mo pouch life, ~18 mo weaning" ;
    sosa:callName "Low guttural cough/cluck, maternal soft clicking, and heavy double hind-foot alarm thump" ;
    sosa:callFundamentalHz "165.0"^^xsd:decimal ;
    envo:habitatStratum "terrestrial_grassy_woodland_and_open_sclerophyll_forest" ;
    envo:elevationMinM "0"^^xsd:integer ;
    envo:elevationMaxM "1800"^^xsd:integer ;
    prov:wasDerivedFrom src:australian-museum-eastern-grey , src:nsw-dpe-kangaroos , src:vba-victoria .

