    q42:maxElasticStrainPct "7.8"^^xsd:decimal ;
    q42:elasticEnergyRecoveryPct "54.0"^^xsd:decimal ;
    q42:elasticEnergyFormula "U = 0.5 * k_tendon * delta_L^2" ;
    rdfs:label "Forelimb and Elastic-Tendon Hindlimb Saltatorial System"@en .

