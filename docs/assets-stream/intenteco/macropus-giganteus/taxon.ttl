# 4. Joint Range-of-Motion (ROM) & Injury Threshold Assertions (24-Joint PGA)
# ============================================================================

rom:hip a q42:JointROM ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:romJoint "hip" ;
    q42:anatomicalTarget anat:forelimb_and_elastic_tendon_hindlimb_system ;
    q42:primaryAxis "flexion_extension_sagittal" ;
    q42:healthyMinRad "-0.58"^^xsd:decimal ;
    q42:healthyMaxRad "1.48"^^xsd:decimal ;
    q42:abductionMinRad "-0.20"^^xsd:decimal ;
    q42:abductionMaxRad "0.40"^^xsd:decimal ;
    q42:injuryThresholdRad "1.68"^^xsd:decimal ;
    q42:obligatePostInjuryBehavior "q42:obligateInjuredAsymmetricLimpGait" ;
    rdfs:label "Hip Joint ROM (Macropus giganteus)"@en .

rom:knee a q42:JointROM ;
    q42:appliesTo qualia:macropus_giganteus ;
    q42:romJoint "knee" ;
    q42:anatomicalTarget anat:forelimb_and_elastic_tendon_hindlimb_system ;
    q42:primaryAxis "flexion_extension_sagittal" ;
    q42:healthyMinRad "-1.78"^^xsd:decimal ;
    q42:healthyMaxRad "-0.10"^^xsd:decimal ;
    q42:injuryThresholdRad "-1.98"^^xsd:decimal ;
