    dwc:scientificName "Ornithorhynchus anatinus (Shaw, 1799)" ;
    rdfs:label "Platypus"@en ;
    rdfs:comment "Riverbank root-stabilized undercut burrow habitat beneath riparian root plates."@en .

qualia:petaurus_norfolcensis a dwc:Taxon ;
