organ:root-system-lignotuber a po:0025025 , po:0009005 , po:0020125 , po:0000045 , po:0003005 ;
    owl:sameAs <did:q42:taxon:eucalyptus_camaldulensis#organ-root-system-lignotuber> ;
    dct:identifier <did:q42:taxon:eucalyptus_camaldulensis#organ-root-system-lignotuber> ;
    rdfs:label "5-order subterranean root-base graph, lignotuber & fluted river-bank buttresses"@en ;
    q42bio:poTerm "PO:0025025" ;
    q42bio:secondaryPoTerm "PO:0020125 (taproot), PO:0000045 (lateral root), PO:0003005 (sinker root), PO:0009005 (lignotuber)" ;
    q42bio:componentId "root-system-lignotuber" ;
    q42bio:taprootAndSinkers "1 deep phreatophytic taproot (-5.4 m) + 7 wide primary laterals (7.0-9.4 m) + 21 secondary laterals + 14 vertical sinkers (-2.8 to -4.6 m) + 28 tertiary/quaternary feeder root fans"@en ;
    q42bio:lignotuberHeightRangeM "-0.8 to +0.4 m subterranean-to-basal woody swelling"@en ;
    q42bio:rootDepthTypicalM "5.4"^^xsd:decimal ;
    q42bio:rootDepthRangeM "2.8 to 12.0 m" ;
    q42bio:rootSpreadRadiusM "9.4"^^xsd:decimal ;
    q42bio:buttressFluteEquation "R(theta, h) = R0(h) * [1 + sum_{k=3}^{7} A_k * exp(-lambda * h) * cos(k * theta + phi_k)]" ;
    q42bio:xpbdRole "fixed_anchor_inv_mass_0_and_overturning_moment" ;
    prov:wasDerivedFrom src:euclid , src:austraits .

organ:mycorrhizal-rhizosphere-network a po:0025025 ;
    owl:sameAs <did:q42:taxon:eucalyptus_camaldulensis#organ-mycorrhizal-rhizosphere-network> ;
    dct:identifier <did:q42:taxon:eucalyptus_camaldulensis#organ-mycorrhizal-rhizosphere-network> ;
    rdfs:label "Ectomycorrhizal (ECM) mycelial hyphal network, Hartig sheaths & rhizosphere EMF/chemo-waveguide"@en ;
    q42bio:poTerm "PO:0025025" ;
    q42bio:componentId "mycorrhizal-rhizosphere-network" ;
    q42bio:mycorrhizalType "ECM (Common Mycorrhizal Network / Hartig net sheaths)" ;
    q42bio:rhizosphereDepthRangeM "-0.20 to -2.20 m" ;
    q42bio:hyphalEmfCarrierHzRange "0.1 to 50.0 Hz (bio-electric action-potential / ionic-conduction waveguide)" ;
    q42bio:rhizospherePermittivity "14.5"^^xsd:decimal ;
    q42bio:hydraulicRedistribution "Deep taproot & sinker groundwater lift sustaining shallow ECM mycelium during drought"@en ;
    q42bio:chemoExudateSignaling "Phenolic allelochemicals, glomalin, organic carbon exudates, and P/N exchange flux"@en ;
    prov:wasDerivedFrom src:austraits , src:tern .

organ:trunk-bark-cambium a po:0025004 , po:0004518 , po:0005849 , po:0005848 , po:0005597 ;
    owl:sameAs <did:q42:taxon:eucalyptus_camaldulensis#organ-trunk-bark-cambium> ;
    dct:identifier <did:q42:taxon:eucalyptus_camaldulensis#organ-trunk-bark-cambium> ;
    rdfs:label "Concentric trunk: heartwood, sapwood, vascular cambium & mottled decorticating bark"@en ;
    q42bio:poTerm "PO:0025004" ;
    q42bio:internalSubsystems "PO:0005849 (heartwood core), PO:0005848 (sapwood annulus), PO:0005597 (vascular cambium), PO:0004518 (basal stocking, smooth upper bole & 10 exfoliating bark ribbons)" ;
    q42bio:componentId "trunk-bark-cambium" ;
    q42bio:barkAppearance "Smooth mottled white, cream, slate-grey, and reddish-brown decorticating plates/ribbons above a persistent rough dark-grey scaly basal stocking (0.5 to 2.0 m)."@en ;
