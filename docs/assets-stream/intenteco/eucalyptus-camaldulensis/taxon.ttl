    q42bio:relativeHeightRange "0.65 to 1.00" ;
    q42bio:hollowBearing "false"^^xsd:boolean ;
    rdfs:comment "Full-canopy riverine tree (20-45 m, DBH 1.0-2.2 m) with wide spreading pipe-model boughs and active reproductive umbels/capsules."@en .

stage:veteran a q42bio:OntogeneticStage ;
    dct:identifier <did:q42:taxon:eucalyptus_camaldulensis#stage-veteran> ;
    rdfs:label "Veteran Hollow-Bearing Tree (0.80 - 1.00)"@en ;
    q42state:ageNormMin "0.80"^^xsd:decimal ;
    q42state:ageNormMax "1.00"^^xsd:decimal ;
    q42bio:relativeHeightRange "0.85 to 1.00" ;
    q42bio:hollowBearing "true"^^xsd:boolean ;
    rdfs:comment "Ancient floodplain patriarch (DBH 2.0-3.5 m) with pronounced buttress flutes, storm-pruned bough stubs, and cavity hollows critical for avian and arboreal fauna."@en .

