# 4. Topological Growth Grammar & Biophysical / Allometric Traits
# -----------------------------------------------------------------------------

q42bio:ecam_pipe_model_grammar a q42bio:AllometricGrowthGrammar ;
    rdfs:label "Eucalyptus camaldulensis Shinozaki/WBE Pipe-Model Grammar"@en ;
    q42bio:pipeModelFormula "r_parent^n = sum(r_child^n)" ;
    q42bio:pipeModelExponent "2.49"^^xsd:decimal ;
    q42bio:forkAngleMinDeg "38.0"^^xsd:decimal ;
    q42bio:forkAngleMaxDeg "62.0"^^xsd:decimal ;
    q42bio:forkAngleTypicalDeg "50.0"^^xsd:decimal ;
    flopo:phyllotaxis_angle_deg "137.5"^^xsd:decimal ;
    q42bio:internodeElongationRatio "0.76"^^xsd:decimal ;
    q42bio:crownOpenSkyTransmittanceMin "0.45"^^xsd:decimal ;
    q42bio:crownOpenSkyTransmittanceMax "0.65"^^xsd:decimal .

qualia:eucalyptus_camaldulensis
    to:plant_height_min "20.0"^^xsd:decimal ;
    to:plant_height_max "45.0"^^xsd:decimal ;
    to:plant_height_typical "30.0"^^xsd:decimal ;
    q42bio:dbhMinM "1.0"^^xsd:decimal ;
    q42bio:dbhMaxM "3.5"^^xsd:decimal ;
    to:stem_dbh_m "1.6"^^xsd:decimal ;
    to:crown_radius_m "11.0"^^xsd:decimal ;
    to:wood_density "900.0"^^xsd:decimal ;
    q42bio:woodDensityRangeKgM3 "850.0 to 930.0 (air-dry/green engineering nominal 900.0 kg/m3)" ;
    to:stem_elasticity_gpa "14.2"^^xsd:decimal ;
    q42bio:modulusOfRuptureMpa "105.0"^^xsd:decimal ;
    to:xylem_p50 "-4.2"^^xsd:decimal ;
    to:specific_leaf_area "6.8"^^xsd:decimal ;
    to:leaf_mass_per_area "147.1"^^xsd:decimal ;
    to:stomatal_conductance "0.31"^^xsd:decimal ;
    to:root_depth_m "8.5"^^xsd:decimal ;
    q42bio:barkVisibleAlbedo "0.42"^^xsd:decimal ;
    q42bio:leafParReflectance "0.11"^^xsd:decimal ;
    q42bio:leafNirReflectance "0.46"^^xsd:decimal ;
    to:natural_sway_freq_hz "0.66"^^xsd:decimal ;
    to:wind_hiss_freq_hz "1150.0"^^xsd:decimal ;
    to:fire_response "epicormic_and_lignotuberous_resprouter" ;
    to:mycorrhizal_type "ECM" ;
    flopo:growth_form "spreading_riparian_eucalypt" ;
    flopo:bark_type "smooth_mottled_decorticating_with_basal_stocking" ;
    envo:biome_preference "Riverine floodplains, alluvial levees, billabong margins & riparian corridors" ;
    envo:elevation_min "10"^^xsd:integer ;
    envo:elevation_max "750"^^xsd:integer ;
    prov:wasDerivedFrom src:austraits , src:euclid , src:vicflora .

