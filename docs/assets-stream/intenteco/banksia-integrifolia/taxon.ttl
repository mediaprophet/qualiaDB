    dwc:scientificNameAuthorship "L.f." ;
    dwc:kingdom "Plantae" ;
    dwc:phylum "Tracheophyta" ;
    dwc:class "Magnoliopsida" ;
    dwc:order "Proteales" ;
    dwc:family "Proteaceae" ;
    dwc:genus "Banksia" ;
    dwc:subgenus "Banksia" ;
    q42:section "Banksia" ;
    q42:series "Salicinae" ;
    dwc:specificEpithet "integrifolia" ;
    dwc:taxonRank "species" ;
    dwc:vernacularName "Coast Banksia"@en ,
                       "Coastal Banksia"@en ,
                       "White Honeysuckle"@en ,
                       "Honeysuckle Oak"@en ,
                       "White Banksia"@en ;
    dwc:taxonID "GBIF:7682229" ;
    dwc:scientificNameID <https://id.biodiversity.org.au/name/apni/107602> ;
    dwc:taxonConceptID <https://id.biodiversity.org.au/taxon/apni/51732899> ;
    aunsl:lsid <https://id.biodiversity.org.au/taxon/apni/51732899> ;
    dcat:landingPage <https://github.com/intenteco/banksia-integrifolia> ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    q42:commonsFramework "SPC" ;
    q42:epistemicScope "sourced_working_taxon_reference" ;
    q42:ecologicalCommunity "Eastern Australian Coastal Foredune, Headland Scrub & Near-Coastal Littoral Woodland" ;
    q42:workingLocality "South-Eastern Australian Coastal Dunes, Headlands & Near-Coastal Sands (QLD-NSW-VIC; exact site and individual occurrence pending)" ;
    rdfs:seeAlso <https://id.biodiversity.org.au/name/apni/107602> ,
                 <https://id.biodiversity.org.au/taxon/apni/51732899> ,
                 <https://bie.ala.org.au/species/https%3A/id.biodiversity.org.au/taxon/apni/51732899> ,
                 <https://www.gbif.org/species/7682229> ,
                 <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?lvl=sp&name=Banksia~integrifolia&page=nswfl> ,
