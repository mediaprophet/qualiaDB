                 <https://profiles.ala.org.au/opus/foa/profile/Banksia%20integrifolia> .

<did:q42:taxon:banksia_integrifolia> a dwc:Taxon ;
    owl:sameAs qualia:banksia_integrifolia ;
    rdfs:label "DID Q42 Locator — Banksia integrifolia L.f."@en .

# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:banksia_serrata a dwc:Taxon ;
    dwc:scientificName "Banksia serrata L.f." ;
    rdfs:label "Saw Banksia / Old Man Banksia"@en .

qualia:banksia_marginata a dwc:Taxon ;
    dwc:scientificName "Banksia marginata Cav." ;
    rdfs:label "Silver Banksia"@en .

qualia:banksia_ericifolia a dwc:Taxon ;
    dwc:scientificName "Banksia ericifolia L.f." ;
    rdfs:label "Heath-leaved Banksia"@en .

qualia:banksia_spinulosa a dwc:Taxon ;
    dwc:scientificName "Banksia spinulosa Sm." ;
    rdfs:label "Hairpin Banksia"@en .

qualia:banksia_paludosa a dwc:Taxon ;
    dwc:scientificName "Banksia paludosa R.Br." ;
    rdfs:label "Swamp Banksia"@en .

qualia:banksia_integrifolia
    owl:differentFrom qualia:banksia_serrata ,
                      qualia:banksia_marginata ,
                      qualia:banksia_ericifolia ,
                      qualia:banksia_spinulosa ,
                      qualia:banksia_paludosa ;
    rdfs:comment "Taxonomic boundary: do not substitute Banksia serrata (alternate coarsely serrate leaves, deeply furrowed corky orange-brown bark, grey-cream spikes, massive serotinous cones), B. marginata (smaller shrub/tree, scattered narrow leaves with blunt truncated/notched apices), B. ericifolia (fine ericoid needle leaves, orange-red spikes), B. spinulosa (linear leaves, dark hooked styles), or B. paludosa (low coastal/heath shrub)."@en .

