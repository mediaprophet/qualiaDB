# RO:0002081 = co-occurs with / overlapping niche; RO:0002434 = interacts with;
# RO:0002444 = symbiont of / mutualist
qualia:banksia_integrifolia
    ro:0002081 qualia:banksia_serrata ,
               qualia:banksia_marginata ;
    ro:0002444 qualia:proteoid_rhizosphere_microbiome ;
    ro:0002434 qualia:phylidonyris_novaehollandiae ,
               qualia:trichoglossus_moluccanus ,
               qualia:acanthorhynchus_tenuirostris ,
               qualia:petaurus_breviceps ;
    q42:biome envo:01000221 , envo:00000171 ;
    q42:ecologicalFunction "coastal_foredune_and_headland_stabilization" ;
    rdfs:comment "Keystone winter-nectar flora of South-Eastern Australian coastal dunes, headlands, and littoral woodlands; stabilizes windblown coastal sands via deep taproots and dense proteoid root mats while sustaining New Holland Honeyeaters, Rainbow Lorikeets, Eastern Spinebills, and nocturnal Sugar Gliders through autumn-winter."@en ;
    prov:wasDerivedFrom src:foa , src:plantnet , src:vicflora , src:ala .

