    rdfs:label "DID Q42 Locator — Eucalyptus melliodora A.Cunn. ex Schauer"@en .

# Non-substitution boundaries (per tree-cases.md TREE-01)
qualia:eucalyptus_albens a dwc:Taxon ;
    dwc:scientificName "Eucalyptus albens Benth." ;
    rdfs:label "White Box"@en .

qualia:eucalyptus_blakelyi a dwc:Taxon ;
    dwc:scientificName "Eucalyptus blakelyi Maiden" ;
    rdfs:label "Blakely's Red Gum"@en .

qualia:eucalyptus_polyanthemos a dwc:Taxon ;
    dwc:scientificName "Eucalyptus polyanthemos Schauer" ;
    rdfs:label "Red Box"@en .

qualia:eucalyptus_microcarpa a dwc:Taxon ;
    dwc:scientificName "Eucalyptus microcarpa (Maiden) Maiden" ;
    rdfs:label "Inland Grey Box"@en .

qualia:eucalyptus_melliodora
    owl:differentFrom qualia:eucalyptus_albens ,
                      qualia:eucalyptus_blakelyi ,
                      qualia:eucalyptus_polyanthemos ,
                      qualia:eucalyptus_microcarpa ;
    rdfs:comment "Taxonomic boundary: do not substitute E. albens (thicker pale grey-white box bark, terminal panicles, larger glaucous barrel/urceolate fruits), E. blakelyi (smooth mottled gum bark and strongly exserted fruit valves), E. polyanthemos (broad orbicular-ovate glaucous leaves, terminal panicles), or E. microcarpa (terminal panicles, narrower subcylindrical fruits)."@en .

