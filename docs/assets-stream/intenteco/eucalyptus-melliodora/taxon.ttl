# 6. ECOLOGICAL INTERACTIONS (RO:*)
# ==============================================================================

qualia:anthochaera_phrygia a dwc:Taxon ;
    dwc:scientificName "Anthochaera phrygia (Shaw, 1794)" ;
    rdfs:label "Regent Honeyeater (Critically Endangered)"@en .

qualia:lathamus_discolor a dwc:Taxon ;
    dwc:scientificName "Lathamus discolor (White, 1790)" ;
    rdfs:label "Swift Parrot (Critically Endangered)"@en .

qualia:petaurus_norfolcensis a dwc:Taxon ;
    dwc:scientificName "Petaurus norfolcensis (Kerr, 1792)" ;
    rdfs:label "Squirrel Glider"@en .

qualia:phascolarctos_cinereus a dwc:Taxon ;
    dwc:scientificName "Phascolarctos cinereus (Goldfuss, 1817)" ;
    rdfs:label "Koala"@en .

qualia:ectomycorrhizal_fungi a dwc:Taxon ;
    rdfs:label "Woodland Ectomycorrhizal Fungal Guild (Basidiomycota / Ascomycota)"@en .

# RO:0002081 = co-occurs with / overlapping niche; RO:0002434 = interacts with;
# RO:0002444 = symbiont of / mutualist
qualia:eucalyptus_melliodora
    ro:0002081 qualia:eucalyptus_albens ,
               qualia:eucalyptus_blakelyi ,
               qualia:eucalyptus_microcarpa ,
               qualia:eucalyptus_polyanthemos ;
    ro:0002444 qualia:ectomycorrhizal_fungi ;
    ro:0002434 qualia:anthochaera_phrygia ,
               qualia:lathamus_discolor ,
               qualia:petaurus_norfolcensis ,
               qualia:phascolarctos_cinereus ;
    q42:biome envo:01000221 , envo:00000446 ;
    rdfs:comment "Keystone canopy species of the Critically Endangered White Box-Yellow Box-Blakely's Red Gum Grassy Woodland ecological community across NSW, ACT, and Victoria; high melliferous nectar yield provides critical seasonal foraging for Regent Honeyeater (Anthochaera phrygia) and Swift Parrot (Lathamus discolor), while veteran hollows support Squirrel Gliders and woodland parrots."@en ;
    prov:wasDerivedFrom src:vicflora , src:plantnet , src:ala .

