@prefix q42:    <urn:qualia:ontology:> .
@prefix qualia: <urn:qualia:taxon:> .

qualia:corvus_coronoides a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:corvus_coronoides> , <https://www.gbif.org/species/2482492> ;
    dct:identifier <urn:qualia:taxon:corvus_coronoides> , <did:q42:taxon:corvus_coronoides> ;
    rdfs:label "Australian Raven"@en , "Corvus coronoides"@la ;
    dwc:kingdom "Animalia" ;
    dwc:family "Corvidae" ;
    dwc:scientificName "Corvus coronoides" ;
    dwc:vernacularName "Australian Raven"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:2482492" ;
    dwc:taxonConceptID <https://biodiversity.org.au/afd/taxa/Corvus_coronoides> ;
    dcat:landingPage <https://github.com/intenteco/corvus-coronoides> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "2.6"^^xsd:decimal ;
    q42:hasAnimationClip "territorial_call_and_throat_hackle_fan" , "vigilant_perch_head_cock_and_tail_flick" , "wing_mantle_takeoff_and_soaring_stroke" , "bipedal_ground_hop_and_foraging_probe" ;
    q42:ecologicalRole "Open eucalypt canopies, riparian corridors, and community commons clearings." ;
    tk:custodial_country "Wiradjuri Country" , "Ngarigo Country" , "Ngunnawal Country" , "Gadigal Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

qualia:corvus_coronoidesShape a sh:NodeShape ;
    sh:targetNode qualia:corvus_coronoides ;
    sh:property [ sh:path dwc:scientificName ; sh:minCount 1 ] ;
    sh:property [ sh:path dwc:taxonID ; sh:minCount 1 ] .
