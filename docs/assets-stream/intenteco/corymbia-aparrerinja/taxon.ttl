qualia:corymbia_aparrerinja a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:corymbia_aparrerinja> , <https://www.gbif.org/species/5416385> ;
    dct:identifier <urn:qualia:taxon:corymbia_aparrerinja> , <did:q42:taxon:corymbia_aparrerinja> ;
    rdfs:label "Ghost Gum (Aparrerinja)"@en , "Corymbia aparrerinja"@la ;
    dwc:kingdom "Plantae" ;
    dwc:family "Myrtaceae" ;
    dwc:scientificName "Corymbia aparrerinja" ;
    dwc:vernacularName "Ghost Gum (Aparrerinja)"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:5416385" ;
    dwc:taxonConceptID <https://id.biodiversity.org.au/name/apni/115098> ;
    dcat:landingPage <https://github.com/intenteco/corymbia-aparrerinja> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "0.85"^^xsd:decimal ;
    q42:hasAnimationClip "canopy_breeze_sway" , "hot_desert_thermal_shimmer" , "seasonal_bark_shed_and_flowering" , "gale_gust_flex_recovery" ;
    q42:ecologicalRole "Alluvial rocky creek beds, dry gullies, and open woodland ridges." ;
    tk:custodial_country "Arrernte Country" , "Wiradjuri Country" , "Ngunnawal Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

qualia:corymbia_aparrerinjaShape a sh:NodeShape ;
    sh:targetNode qualia:corymbia_aparrerinja ;
    sh:property [ sh:path dwc:scientificName ; sh:minCount 1 ] ;
    sh:property [ sh:path dwc:taxonID ; sh:minCount 1 ] .
