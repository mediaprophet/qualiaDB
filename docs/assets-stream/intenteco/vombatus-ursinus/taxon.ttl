# --- Layer 0: Osteology (UBERON:0001434) ---

anat:skeletal_system a uberon:0001434 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001434" ;
    q42:anatomyLayer "osteology" ;
    ro:0002131 qualia:vombatus_ursinus ;
    q42:rigJointCount "24"^^xsd:integer ;
    q42:boneDensityScale "1.35"^^xsd:decimal ;
    rdfs:label "Robust Fossorial Skeletal System (24-Joint Quadruped Rig)"@en ;
    rdfs:comment "Heavy, low-slung, compact fossorial skeleton engineered to resist high burrowing reaction forces and overhead burrow-defense compression."@en .

anat:cranium_zygomatic a uberon:0003129 , uberon:0001682 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0003129" ;
    q42:secondaryUberonCurie "UBERON:0001682" ;
    q42:anatomyLayer "osteology" ;
    ro:0002131 anat:skeletal_system ;
    q42:cranialProfile "Dorsoventrally flattened broad cranium with massively flared zygomatic arches" ;
    rdfs:label "Flattened Broad Cranium and Flared Zygomatic Arches"@en ;
    rdfs:comment "Broad skull roof acts as a passive wedge while flared zygomatic arches create wide temporal fossae for hypertrophied masseter and temporalis jaw adductors."@en .

anat:hypselodont_dentition a uberon:0001759 , q42:AnatomicalSubsystem ;
    q42:uberonCurie "UBERON:0001759" ;
    q42:anatomyLayer "osteology" ;
    ro:0002131 anat:cranium_zygomatic ;
    q42:dentalFormula "I 1/1, C 0/0, P 1/1, M 4/4 (24 rootless teeth)" ;
    q42:toothGrowthMode "hypselodont_continuously_growing_rootless" ;
    rdfs:label "Hypselodont Rootless Continuously Growing Incisors and Molars"@en ;
    rdfs:comment "Unique among living marsupials: all 24 teeth (chisel-like incisors and bilophodont cheek teeth) lack roots and erupt continuously to compensate for extreme silica wear from native tussock grasses and roots."@en .

