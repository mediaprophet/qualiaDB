# ============================================================================
# 6. Ecological Interactions (Grazing Ecology, Burrow Ecosystem Engineering)
# ============================================================================

qualia:poa_sieberiana a dwc:Taxon ;
    dwc:scientificName "Poa sieberiana Spreng." ;
    rdfs:label "Snow Tussock Grass"@en .

qualia:themeda_triandra a dwc:Taxon ;
    dwc:scientificName "Themeda triandra Forssk." ;
    rdfs:label "Kangaroo Grass"@en .

qualia:carex_appressa a dwc:Taxon ;
    dwc:scientificName "Carex appressa R.Br." ;
    rdfs:label "Tall Sedge"@en .

qualia:lomandra_longifolia a dwc:Taxon ;
    dwc:scientificName "Lomandra longifolia Labill." ;
    rdfs:label "Spiny-Headed Mat-Rush"@en .

qualia:vombatus_ursinus
    ro:0002470 qualia:poa_sieberiana ,
               qualia:themeda_triandra ,
               qualia:carex_appressa ,
               qualia:lomandra_longifolia ;
    rorel:trophically_interacts_with qualia:poa_sieberiana ,
                                     qualia:themeda_triandra ,
                                     qualia:carex_appressa ,
                                     qualia:lomandra_longifolia ;
    ro:0002303 envo:01000220 ;
    q42:ecologicalFunction "Allogenic ecosystem engineer excavating 15-30 m thermal-refuge burrow networks utilized by native mammals, reptiles, and birds during bushfires and temperature extremes; coarse tussock grazer shaping grass-lawn swards."@en ;
    rdfs:comment "NSW NPWS and Victorian Biodiversity Atlas document Vombatus ursinus across coastal forests, mountain ranges, subalpine snow-grass plains, and western slopes, feeding on Poa sieberiana, Themeda triandra, sedges, rushes, and subterranean roots."@en .

