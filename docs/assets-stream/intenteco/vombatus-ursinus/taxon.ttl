# ============================================================================
# 3. Biophysical, Morphometric, Allometric & Burrow Kinematic Parameters
# ============================================================================

qualia:vombatus_ursinus
    q42:headBodyLengthMinM "0.85"^^xsd:decimal ;
    q42:headBodyLengthMaxM "1.15"^^xsd:decimal ;
    q42:shoulderHeightMinM "0.35"^^xsd:decimal ;
    q42:shoulderHeightMaxM "0.45"^^xsd:decimal ;
    q42:tailLengthMinM "0.02"^^xsd:decimal ;
    q42:tailLengthMaxM "0.035"^^xsd:decimal ;
    q42:adultMassMinKg "22.0"^^xsd:decimal ;
    q42:adultMassMaxKg "38.0"^^xsd:decimal ;
    q42:adultFemaleMassRangeKg "22.0 to 34.0" ;
    q42:adultMaleMassRangeKg "25.0 to 38.0" ;
    q42:bmrWatts "32.0"^^xsd:decimal ;
    q42:bodyTempC "34.8"^^xsd:decimal ;
    q42:thermoregulation "endotherm_fossorial_hypometabolic" ;
    q42:allometricBmrEquation "BMR(M) = 2.40 * M^0.75 [W]; at M=31.7 kg -> 32.0 W (depressed fossorial marsupial BMR reducing burrow heat load & hypoxia)" ;
    q42:allometricLimbEquation "L_humerus = 0.048 * M^0.33 [m]; L_radius = 0.052 * M^0.33 [m]; L_femur = 0.062 * M^0.33 [m]" ;
    q42:burrowTunnelLengthMinM "15.0"^^xsd:decimal ;
    q42:burrowTunnelLengthMaxM "30.0"^^xsd:decimal ;
    q42:burrowDepthMaxM "3.5"^^xsd:decimal ;
    q42:burrowExcavationMechanics "Alternating fossorial forelimb scrape powered by triceps/pectoralis/latissimus over flared deltopectoral crest, hindlimbs bracing floor, periodic soil bulldozing with hind feet and chest" ;
    q42:locomotorWalkSpeedMs "0.8 to 1.5" ;
    q42:locomotorSprintSpeedMaxMs "11.1"^^xsd:decimal ;
    q42:activityCycle "crepuscular_nocturnal_cool_day_basking" ;
    q42:dietGuild "obligate_fossorial_grazing_herbivore" ;
    q42:reproductionStrategy "Single pouch young per ~20-22 d gestation; 6-9 mo backward-pouch lactation followed by 6-12 mo juvenile-at-heel" ;
    sosa:callName "Low guttural growl, rasping hiss, and territorial tooth-chatter" ;
    sosa:callFundamentalHz "110.0"^^xsd:decimal ;
    envo:habitatStratum "terrestrial_subterranean_burrow_and_forest_grassland_ecotone" ;
    envo:elevationMinM "0"^^xsd:integer ;
    envo:elevationMaxM "1850"^^xsd:integer ;
    prov:wasDerivedFrom src:nsw-npws-bare-nosed-wombat , src:nsw-dpe-wombats , src:vic-wildlife-common-wombat .

