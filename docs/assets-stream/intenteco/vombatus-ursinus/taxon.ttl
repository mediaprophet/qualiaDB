# ============================================================================
# 5. InstanceState64 Ontogenetic Stages & 64-Byte Phenotype Parameter Bounds
# ============================================================================

inst64:vombatus_ursinus_layout a q42:InstanceState64Schema ;
    q42:appliesTo qualia:vombatus_ursinus ;
    q42:byteSize "64"^^xsd:integer ;
    q42:fields "seed:u64, ontogenetic_age_norm:f32, height_scale:f32, site_vigor:f32, environmental_stress:f32[4], sex_dimorphism_flag:u8, pouch_occupancy_flag:u8, pelage_grizzle_melanin:f32, mange_stress_01:f32" ;
    q42:seedRange "0 to 18446744073709551615" ;
    q42:ontogeneticAgeNormRange "0.00 to 1.00" ;
    q42:heightScaleRange "0.14 to 1.15" ;
    q42:siteVigorRange "0.45 to 1.25" ;
    q42:environmentalStressRange "0.00 to 1.00" ;
    rdfs:label "InstanceState64 Phenotype Parameter Layout for Vombatus ursinus"@en .

stage:pouch_young a q42:OntogeneticStage ;
    q42:appliesTo qualia:vombatus_ursinus ;
    q42:stageId "pouch_young" ;
    q42:ontogeneticAgeNormMin "0.00"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.16"^^xsd:decimal ;
    q42:heightScaleMin "0.14"^^xsd:decimal ;
    q42:heightScaleMax "0.34"^^xsd:decimal ;
    q42:massRangeKg "0.0005 to 2.5" ;
    q42:independentLocomotion false ;
    rdfs:label "Pouch Young (0-8 months, inside backward-opening marsupium)"@en .

stage:juvenile_at_heel a q42:OntogeneticStage ;
    q42:appliesTo qualia:vombatus_ursinus ;
    q42:stageId "juvenile_at_heel" ;
    q42:ontogeneticAgeNormMin "0.16"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.36"^^xsd:decimal ;
    q42:heightScaleMin "0.34"^^xsd:decimal ;
    q42:heightScaleMax "0.62"^^xsd:decimal ;
    q42:massRangeKg "2.5 to 10.5" ;
    q42:independentLocomotion true ;
    rdfs:label "Juvenile-at-Heel (8-18 months, following mother & learning grazing/burrowing)"@en .

stage:subadult a q42:OntogeneticStage ;
    q42:appliesTo qualia:vombatus_ursinus ;
    q42:stageId "subadult" ;
    q42:ontogeneticAgeNormMin "0.36"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "0.58"^^xsd:decimal ;
    q42:heightScaleMin "0.62"^^xsd:decimal ;
    q42:heightScaleMax "0.86"^^xsd:decimal ;
    q42:massRangeKg "10.5 to 21.5" ;
    q42:independentLocomotion true ;
    rdfs:label "Subadult Dispersal Stage (18-24 months, establishing independent burrow network)"@en .

stage:adult_female a q42:OntogeneticStage ;
    q42:appliesTo qualia:vombatus_ursinus ;
    q42:stageId "adult_female" ;
    q42:ontogeneticAgeNormMin "0.58"^^xsd:decimal ;
    q42:ontogeneticAgeNormMax "1.00"^^xsd:decimal ;
    q42:heightScaleMin "0.86"^^xsd:decimal ;
    q42:heightScaleMax "1.05"^^xsd:decimal ;
    q42:massRangeKg "22.0 to 34.0" ;
    q42:shoulderHeightMinM "0.35"^^xsd:decimal ;
    q42:shoulderHeightMaxM "0.42"^^xsd:decimal ;
    q42:karyotype "2n=14 (XX)" ;
    q42:supportsPouchOccupancy true ;
    rdfs:label "Adult Female (2n=14 XX, backward-opening marsupium)"@en .

stage:adult_male a q42:OntogeneticStage ;
