qualia:callistemon_sieberi a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:callistemon_sieberi> , <https://www.gbif.org/species/3182358> ;
    dct:identifier <urn:qualia:taxon:callistemon_sieberi> , <did:q42:taxon:callistemon_sieberi> ;
    rdfs:label "River Bottlebrush"@en , "Callistemon sieberi"@la ;
    dwc:kingdom "Plantae" ;
    dwc:family "Myrtaceae" ;
    dwc:scientificName "Callistemon sieberi" ;
    dwc:vernacularName "River Bottlebrush"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:3182358" ;
    dwc:taxonConceptID <https://id.biodiversity.org.au/name/apni/60187> ;
    dcat:landingPage <https://github.com/intenteco/callistemon-sieberi> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "1.35"^^xsd:decimal ;
    q42:hasAnimationClip "riparian_wind_oscillation" , "flood_current_streamline_bend" , "spring_stamen_anthesis_unfold" , "nectarivore_perch_rebound" ;
    q42:ecologicalRole "Riparian stream banks, gravel bars, and seasonally inundated floodplains." ;
    tk:custodial_country "Wiradjuri Country" , "Ngarigo Country" , "Ngunnawal Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

