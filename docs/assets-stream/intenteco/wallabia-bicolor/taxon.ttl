# ============================================================================
# 6. Ecological Interactions (Browser Diet, Fungi Dispersal & Habitat)
# ============================================================================

qualia:pteridium_esculentum a dwc:Taxon ;
    dwc:scientificName "Pteridium esculentum (G.Forst.) Cockayne" ;
    rdfs:label "Austral Bracken Fern"@en .

qualia:dicksonia_antarctica a dwc:Taxon ;
    dwc:scientificName "Dicksonia antarctica Labill." ;
    rdfs:label "Soft Tree Fern"@en .

qualia:acacia_dealbata a dwc:Taxon ;
    dwc:scientificName "Acacia dealbata Link" ;
    rdfs:label "Silver Wattle"@en .

qualia:eucalyptus_dalrympleana a dwc:Taxon ;
    dwc:scientificName "Eucalyptus dalrympleana Maiden subsp. dalrympleana" ;
    rdfs:label "Mountain White Gum"@en .

qualia:hypogeous_fungi_truffles a dwc:Taxon ;
    dwc:scientificName "Mesophellia / Hysterangium spp." ;
    rdfs:label "Subterranean Hypogeous Fungi (Ectomycorrhizal Truffles)"@en .

qualia:wallabia_bicolor
    ro:0002470 qualia:pteridium_esculentum ,
               qualia:dicksonia_antarctica ,
               qualia:acacia_dealbata ,
               qualia:eucalyptus_dalrympleana ,
               qualia:hypogeous_fungi_truffles ;
    rorel:trophically_interacts_with qualia:pteridium_esculentum ,
                                     qualia:dicksonia_antarctica ,
                                     qualia:acacia_dealbata ,
                                     qualia:eucalyptus_dalrympleana ,
                                     qualia:hypogeous_fungi_truffles ;
    ro:0002303 envo:01000220 ;
    q42:ecologicalFunction "Selective woody/fern browser and mycophagous vector dispersing ectomycorrhizal truffle spores across SE Australian forest floors."@en ;
    rdfs:comment "Kosciuszko National Park Plan of Management (p. 71) notes Swamp Wallaby presence in the subalpine zone year-round; NPWS profile documents dense forest/woodland/heath understory use and night/crepuscular foraging."@en .

