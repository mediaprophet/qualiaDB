# ============================================================================
# 3. Biophysical, Morphometric, Allometric & Kinematic Parameters
# ============================================================================

qualia:wallabia_bicolor
    q42:headBodyLengthMinM "0.66"^^xsd:decimal ;
    q42:headBodyLengthMaxM "0.85"^^xsd:decimal ;
    q42:tailLengthMinM "0.64"^^xsd:decimal ;
    q42:tailLengthMaxM "0.86"^^xsd:decimal ;
    q42:standingCrouchedHeightMinM "0.58"^^xsd:decimal ;
    q42:standingCrouchedHeightMaxM "0.72"^^xsd:decimal ;
    q42:adultMassMinKg "13.0"^^xsd:decimal ;
    q42:adultMassMaxKg "20.5"^^xsd:decimal ;
    q42:adultFemaleMassRangeKg "13.0 to 15.5" ;
    q42:adultMaleMassRangeKg "16.0 to 20.5" ;
    q42:bmrWatts "24.5"^^xsd:decimal ;
    q42:bodyTempC "36.3"^^xsd:decimal ;
    q42:thermoregulation "endotherm" ;
    q42:allometricBmrEquation "BMR(M) = 2.86 * M^0.75 [W]; at M=17.6 kg -> 24.5 W (marsupial scaling)" ;
    q42:allometricSegmentEquation "L_pes = 0.105 * M^0.34 [m]; L_tibia = 0.145 * M^0.34 [m]; L_femur = 0.088 * M^0.33 [m]" ;
    q42:browsingGait "Low head-down pentapedal/quadrupedal browse gait (0.6-1.4 m/s, cervical pitch -0.45 to -0.20 rad, tail trailing prop)" ;
    q42:saltatorialGait "High-speed bipedal elastic-recoil hop (4.5-13.2 m/s, Achilles tendon energy recovery, tail counter-torque)" ;
    q42:evasionStrategy "Cryptic freeze in dense understory followed by low-profile zig-zag bounding flight" ;
    q42:activityCycle "cathemeral_crepuscular_nocturnal" ;
    q42:dietGuild "obligate_selective_browser" ;
    q42:reproductionStrategy "Continuous embryonic diapause with overlapping gestation (~33-38 d) and pouch lactation (~8-9 mo)" ;
    sosa:callName "Low nasal grunt, soft hiss, and heavy single hind-foot ground thump" ;
    sosa:callFundamentalHz "195.0"^^xsd:decimal ;
    envo:habitatStratum "terrestrial_dense_understory" ;
    envo:elevationMinM "0"^^xsd:integer ;
    envo:elevationMaxM "1750"^^xsd:integer ;
    prov:wasDerivedFrom src:nsw-npws-swamp-wallaby , src:kosciuszko-pom-2006 .

