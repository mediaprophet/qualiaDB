# Qualified Identifier Conflict & Mapping Records (WALLABY-01 / KN-02)
claim:gbif-2440154-discrepancy a rdf:Statement ;
    rdf:subject qualia:wallabia_bicolor ;
    rdf:predicate q42:disputedIdentifierRef ;
    rdf:object <https://www.gbif.org/species/2440154> ;
    q42:mappingStatus "disputed" ;
    prov:wasDerivedFrom src:gbif-2440149 , src:gbif-2440154-audit ;
    rdfs:comment "ECO-WP-03A prompt cited GBIF 2440154, which resolves to Lagorchestes Gould, 1841 in GBIF Backbone API; verified Wallabia bicolor (Desmarest, 1804) GBIF speciesKey is 2440149. Legacy east_coast_fauna_64.ttl reference GBIF:2440182 returns HTTP 404."@en .

claim:karyotype-derived-macropod a rdf:Statement ;
    rdf:subject qualia:wallabia_bicolor ;
    rdf:predicate q42:karyotypeFemale ;
    rdf:object "2n=10 (XX)" ;
    rdfs:comment "Most derived/lowest diploid chromosome count in Macropodidae (2n=10 female XX; 2n=11 male XY1Y2 compound sex chromosome system), supporting monotypic genus Wallabia."@en .

