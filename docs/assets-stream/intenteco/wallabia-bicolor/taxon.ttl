    q42:healthyMinRad "-0.65"^^xsd:decimal ;
    q42:healthyMaxRad "0.75"^^xsd:decimal ;
    q42:lateralSweepMaxRad "0.45"^^xsd:decimal ;
    q42:injuryThresholdRad "0.95"^^xsd:decimal ;
    q42:obligatePostInjuryBehavior "q42:obligateInjuredAsymmetricLimpGait" ;
    rdfs:label "Caudal Tail Articulated Chain ROM (Wallabia bicolor)"@en .

