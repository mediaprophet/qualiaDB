@prefix q42:    <urn:qualia:ontology:> .
@prefix qualia: <urn:qualia:taxon:> .

qualia:iridomyrmex_purpureus a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    owl:sameAs <did:q42:taxon:iridomyrmex_purpureus> , <https://www.gbif.org/species/1320185> ;
    dct:identifier <urn:qualia:taxon:iridomyrmex_purpureus> , <did:q42:taxon:iridomyrmex_purpureus> ;
    rdfs:label "Australian Meat Ant"@en , "Iridomyrmex purpureus"@la ;
    dwc:kingdom "Animalia" ;
    dwc:family "Formicidae" ;
    dwc:scientificName "Iridomyrmex purpureus" ;
    dwc:vernacularName "Australian Meat Ant"@en ;
    dwc:taxonRank "species" ;
    dwc:taxonID "GBIF:1320185" ;
    dwc:taxonConceptID <https://biodiversity.org.au/afd/taxa/Iridomyrmex_purpureus> ;
    dcat:landingPage <https://github.com/intenteco/iridomyrmex-purpureus> ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:naturalSwayFreqHz "3.2"^^xsd:decimal ;
    q42:hasAnimationClip "alternating_tripod_foraging_gait" , "antennal_chemosensory_sweep" , "mandible_defensive_flare_and_gaster_flex" , "stridulation_alarm_vibration" ;
    q42:ecologicalRole "Open sunny gravel nest mounds, dry woodland trails, and honeydew foraging corridors." ;
    tk:custodial_country "Wiradjuri Country" , "Ngunnawal Country" , "Ngarigo Country" ;
    tk:noticeType "TK_Notice_Open_To_Collaborate" , "BC_Notice_Biocultural_Provenance" .

qualia:iridomyrmex_purpureusShape a sh:NodeShape ;
    sh:targetNode qualia:iridomyrmex_purpureus ;
    sh:property [ sh:path dwc:scientificName ; sh:minCount 1 ] ;
    sh:property [ sh:path dwc:taxonID ; sh:minCount 1 ] .
