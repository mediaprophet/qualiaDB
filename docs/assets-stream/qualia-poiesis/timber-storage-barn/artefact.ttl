design:rev1 a made:Artefact , made:AgriculturalBuilding , dcat:Dataset ;
    owl:sameAs <did:q42:design:timber_storage_barn> ;
    dct:identifier <urn:qualia:design:timber-storage-barn:rev1> , <did:q42:design:timber_storage_barn> ;
    rdfs:label "Community Nursery, Seed Exchange & Reclaimed Timber Barn"@en ;
    dct:title "Community Nursery, Seed Exchange & Reclaimed Timber Barn — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/timber-storage-barn> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "double_barn_doors_and_loft_hatch_swing" , "hay_loft_hoist_beam_loading" , "nursery_seedling_bed_canopy_sway" , "timber_frame_wind_settling" ;
    made:lengthM "4.440"^^xsd:decimal ;
    made:widthM "3.760"^^xsd:decimal ;
    made:heightM "3.550"^^xsd:decimal ;
    made:curbMassKg "8600.0"^^xsd:decimal ;
    made:modalSwayFreqHz "2.9"^^xsd:decimal ;
    made:totalAuthoredParts "29"^^xsd:integer ;
    made:hasComponent part:stone-plinth , part:barn-timber-shell , part:timber-post-0 , part:timber-post-1 , part:timber-post-2 , part:timber-post-3 , part:timber-post-4 , part:timber-post-5 , part:front-eave-girt , part:front-barn-door-left , part:door-cross-batten-left , part:door-diag-brace-left , part:side-framed-window-left , part:front-barn-door-right , part:door-cross-batten-right , part:door-diag-brace-right , part:side-framed-window-right , part:corrugated-gable-roof ;
    made:hasPort port:barn-lighting-bus-24v , port:rainwater-gutter-harvest .

