design:rev1 a made:Artefact , made:RecreationalVehicle , dcat:Dataset ;
    owl:sameAs <did:q42:design:touring_campervan> ;
    dct:identifier <urn:qualia:design:touring-campervan:rev1> , <did:q42:design:touring_campervan> ;
    rdfs:label "Two-Tone Vintage Ecopunk Touring Campervan & Mobile Knowledge Node"@en ;
    dct:title "Two-Tone Vintage Ecopunk Touring Campervan & Mobile Knowledge Node — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/touring-campervan> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "pop_top_roof_and_awning_deployment" , "camper_cruising_suspension_and_wheel_spin" , "field_coworking_table_setup" , "rooftop_solar_charge_modulation" ;
    made:lengthM "3.240"^^xsd:decimal ;
    made:widthM "2.350"^^xsd:decimal ;
    made:heightM "2.240"^^xsd:decimal ;
    made:curbMassKg "2680.0"^^xsd:decimal ;
    made:modalSwayFreqHz "1.35"^^xsd:decimal ;
    made:totalAuthoredParts "45"^^xsd:integer ;
    made:hasComponent part:van-chassis , part:van-lower-orange-hull , part:beltline-trim-moulding , part:van-upper-cream-cabin , part:poptop-camper-roof , part:roof-solar-panel-front , part:roof-solar-panel-rear , part:split-windshield-left , part:panoramic-window-left-0 , part:panoramic-window-left-1 , part:panoramic-window-left-2 , part:wing-mirror-left , part:split-windshield-right , part:panoramic-window-right-0 , part:panoramic-window-right-1 , part:panoramic-window-right-2 , part:wing-mirror-right , part:rear-hatch-window ;
    made:hasPort port:house-battery-dc-48v , port:potable-water-inlet .

