design:rev1 a made:Artefact , made:WorkshopFacility , dcat:Dataset ;
    owl:sameAs <did:q42:design:commons_rig_workshop> ;
    dct:identifier <urn:qualia:design:commons-rig-workshop:rev1> , <did:q42:design:commons_rig_workshop> ;
    rdfs:label "Active Civic Maker Repair Hub & Solar Cooperative Workshop"@en ;
    dct:title "Active Civic Maker Repair Hub & Solar Cooperative Workshop — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/commons-rig-workshop> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "gantry_hoist_trolley_and_hook_travel" , "fabrication_3d_printer_and_ai_terminal_cycle" , "microgrid_battery_cabinet_telemetry_pulse" , "portal_truss_wind_load_harmonic" ;
    made:lengthM "4.600"^^xsd:decimal ;
    made:widthM "3.600"^^xsd:decimal ;
    made:heightM "3.220"^^xsd:decimal ;
    made:curbMassKg "4850.0"^^xsd:decimal ;
    made:modalSwayFreqHz "2.8"^^xsd:decimal ;
    made:totalAuthoredParts "68"^^xsd:integer ;
    made:hasComponent part:concrete-floor-slab , part:front-column-0 , part:rear-column-0 , part:roof-rafter-front-0 , part:roof-rafter-rear-0 , part:tie-beam-0 , part:front-column-1 , part:rear-column-1 , part:roof-rafter-front-1 , part:roof-rafter-rear-1 , part:tie-beam-1 , part:front-column-2 , part:rear-column-2 , part:roof-rafter-front-2 , part:roof-rafter-rear-2 , part:tie-beam-2 , part:front-column-3 , part:rear-column-3 ;
    made:hasPort port:microgrid-bus-48v , port:compressed-air-manifold , port:solid-knowledge-bank-fiber .

