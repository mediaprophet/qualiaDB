design:rev1 a made:Artefact , made:UtilityVehicle , dcat:Dataset ;
    owl:sameAs <did:q42:design:rover_field_utility_4wd> ;
    dct:identifier <urn:qualia:design:rover-field-utility-4wd:rev1> , <did:q42:design:rover_field_utility_4wd> ;
    rdfs:label "Australian Field Utility & Ecological Survey 4WD Rover"@en ;
    dct:title "Australian Field Utility & Ecological Survey 4WD Rover — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/rover-field-utility-4wd> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "all_terrain_wheel_roll_and_suspension_articulation" , "ackermann_front_steering_sweep" , "hood_and_expedition_case_service_access" , "bullbar_winch_and_headlight_beam" ;
    made:lengthM "2.860"^^xsd:decimal ;
    made:widthM "1.880"^^xsd:decimal ;
    made:heightM "2.180"^^xsd:decimal ;
    made:curbMassKg "2340.0"^^xsd:decimal ;
    made:modalSwayFreqHz "1.45"^^xsd:decimal ;
    made:totalAuthoredParts "47"^^xsd:integer ;
    made:hasComponent part:chassis-frame , part:lower-body-tub , part:front-engine-hood , part:hood-power-bulge , part:fender-flare-0 , part:fender-flare-1 , part:fender-flare-2 , part:fender-flare-3 , part:cabin-greenhouse , part:front-windshield-glass , part:rear-tailgate-glass , part:side-front-glass-left , part:side-rear-glass-left , part:wing-mirror-left , part:rock-slider-step-left , part:side-front-glass-right , part:side-rear-glass-right , part:wing-mirror-right ;
    made:hasPort port:aux-dc-bus-24v , port:rear-tow-hitch-50mm .

