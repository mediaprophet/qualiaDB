    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "camp_setup_awning_and_stabilizer_jacks" , "trailing_axle_suspension_and_drawbar_pitch" , "roof_vent_hatch_and_solar_tilt" , "outdoor_education_desk_deploy" ;
    made:lengthM "3.160"^^xsd:decimal ;
    made:widthM "2.380"^^xsd:decimal ;
    made:heightM "2.020"^^xsd:decimal ;
    made:curbMassKg "920.0"^^xsd:decimal ;
    made:modalSwayFreqHz "1.75"^^xsd:decimal ;
    made:totalAuthoredParts "39"^^xsd:integer ;
    made:hasComponent part:trailer-chassis , part:drawbar-arm-left , part:drawbar-arm-right , part:jockey-wheel-post , part:jockey-wheel-roller , part:lpg-gas-cylinder-left , part:lpg-gas-cylinder-right , part:stabilizer-jack-0 , part:stabilizer-jack-1 , part:stabilizer-jack-2 , part:stabilizer-jack-3 , part:caravan-main-shell , part:amber-waist-stripe , part:aluminum-rub-rail , part:front-panoramic-window , part:rear-panoramic-window , part:front-clearance-lamp-0 , part:front-clearance-lamp-1 ;
    made:hasPort port:trailer-coupler-50mm , port:camp-microgrid-plug-24v , port:lpg-dual-regulator-manifold .

