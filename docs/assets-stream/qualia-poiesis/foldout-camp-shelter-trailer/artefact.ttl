design:rev1 a made:Artefact , made:CampTrailer , dcat:Dataset ;
    owl:sameAs <did:q42:design:foldout_camp_shelter_trailer> ;
    dct:identifier <urn:qualia:design:foldout-camp-shelter-trailer:rev1> , <did:q42:design:foldout_camp_shelter_trailer> ;
    rdfs:label "Vintage Brushed-Aluminum & Expedition Restoration Camper Trailer"@en ;
    dct:title "Vintage Brushed-Aluminum & Expedition Restoration Camper Trailer — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
