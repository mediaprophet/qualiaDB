design:rev1 a made:Artefact , made:EnergyFacility , dcat:Dataset ;
    owl:sameAs <did:q42:design:offgrid_solar_battery_station> ;
    dct:identifier <urn:qualia:design:offgrid-solar-battery-station:rev1> , <did:q42:design:offgrid_solar_battery_station> ;
    rdfs:label "Decentralized Solar Microgrid, LiFePO4 Battery Bank & Charging Station"@en ;
    dct:title "Decentralized Solar Microgrid, LiFePO4 Battery Bank & Charging Station — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/offgrid-solar-battery-station> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "single_axis_solar_elevation_tracking" , "lifepo4_battery_soc_and_inverter_pulse" , "safe_haven_charging_bollard_handshake" , "wind_gust_rack_damping" ;
    made:lengthM "3.600"^^xsd:decimal ;
    made:widthM "2.500"^^xsd:decimal ;
    made:heightM "1.850"^^xsd:decimal ;
    made:curbMassKg "1480.0"^^xsd:decimal ;
    made:modalSwayFreqHz "4.2"^^xsd:decimal ;
    made:totalAuthoredParts "29"^^xsd:integer ;
    made:hasComponent part:concrete-equipment-pad , part:front-rack-leg-0 , part:rear-rack-leg-0 , part:tilt-rafter-beam-0 , part:front-rack-leg-1 , part:rear-rack-leg-1 , part:tilt-rafter-beam-1 , part:front-rack-leg-2 , part:rear-rack-leg-2 , part:tilt-rafter-beam-2 , part:lower-purlin-rail , part:upper-purlin-rail , part:solar-pv-frame-0 , part:solar-pv-cells-0 , part:solar-pv-frame-1 , part:solar-pv-cells-1 , part:solar-pv-frame-2 , part:solar-pv-cells-2 ;
    made:hasPort port:pv-dc-string-input , port:microgrid-ac-feeder , port:safe-haven-ev-charger .

