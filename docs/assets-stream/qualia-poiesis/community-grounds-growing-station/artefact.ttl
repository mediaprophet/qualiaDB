design:rev1 a made:Artefact , made:AgriculturalDevice , dcat:Dataset ;
    owl:sameAs <did:q42:design:community_grounds_growing_station> ;
    dct:identifier <urn:qualia:design:community-grounds-growing-station:rev1> , <did:q42:design:community_grounds_growing_station> ;
    rdfs:label "Community Grounds Stepped NFT Hydroponic & Reed-Bed Biofilter Station"@en ;
    dct:title "Community Grounds Stepped NFT Hydroponic & Reed-Bed Biofilter Station — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/community-grounds-growing-station> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "nutrient_film_and_reedbed_recirculation" , "crop_rosette_phototropic_growth" , "wetland_reed_breeze_ripple" , "filter_manifold_backwash_cycle" ;
    made:lengthM "2.600"^^xsd:decimal ;
    made:widthM "1.850"^^xsd:decimal ;
    made:heightM "1.720"^^xsd:decimal ;
    made:curbMassKg "245.0"^^xsd:decimal ;
    made:modalSwayFreqHz "2.4"^^xsd:decimal ;
    made:totalAuthoredParts "42"^^xsd:integer ;
    made:hasComponent part:post-front-L , part:post-rear-L , part:rail-low-L , part:rail-mid-L , part:rail-high-L , part:brace-fwd-L , part:brace-bwd-L , part:post-front-R , part:post-rear-R , part:rail-low-R , part:rail-mid-R , part:rail-high-R , part:brace-fwd-R , part:brace-bwd-R , part:leveling-foot-0 , part:leveling-foot-1 , part:leveling-foot-2 , part:leveling-foot-3 ;
    made:hasPort port:dc-pump-24v , port:nutrient-supply-manifold , port:reed-bed-biofilter-loop .

