design:rev1 a made:Artefact , made:CivicBuilding , dcat:Dataset ;
    owl:sameAs <did:q42:design:community_civic_hall> ;
    dct:identifier <urn:qualia:design:community-civic-hall:rev1> , <did:q42:design:community_civic_hall> ;
    rdfs:label "Civic Knowledge Cooperative Rammed-Earth & Timber Pavilion"@en ;
    dct:title "Civic Knowledge Cooperative Rammed-Earth & Timber Pavilion — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/community-civic-hall> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "civic_bell_cupola_peal_oscillation" , "double_entry_doors_welcome_open" , "solar_skylight_louvre_modulation" , "verandah_planter_foliage_breeze" ;
    made:lengthM "5.200"^^xsd:decimal ;
    made:widthM "4.400"^^xsd:decimal ;
    made:heightM "4.550"^^xsd:decimal ;
    made:curbMassKg "14200.0"^^xsd:decimal ;
    made:modalSwayFreqHz "3.4"^^xsd:decimal ;
    made:totalAuthoredParts "34"^^xsd:integer ;
    made:hasComponent part:stone-foundation-plinth , part:verandah-timber-deck , part:front-entry-steps , part:rammed-earth-hall , part:verandah-column-0 , part:verandah-column-1 , part:verandah-column-2 , part:verandah-column-3 , part:verandah-column-4 , part:verandah-column-5 , part:verandah-header-beam , part:entry-door-leaf-left , part:front-window-left , part:side-panoramic-window-left , part:entry-planter-pot-left , part:entry-shrub-crown-left , part:entry-door-leaf-right , part:front-window-right ;
    made:hasPort port:community-ac-microgrid , port:civic-mesh-uplink .

