design:rev1 a made:Artefact , made:CivicAmenity , dcat:Dataset ;
    owl:sameAs <did:q42:design:farmers_market_harvest_stall> ;
    dct:identifier <urn:qualia:design:farmers-market-harvest-stall:rev1> , <did:q42:design:farmers_market_harvest_stall> ;
    rdfs:label "Community Nursery, Seed Exchange & Harvest Commons Market Stall"@en ;
    dct:title "Community Nursery, Seed Exchange & Harvest Commons Market Stall — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/farmers-market-harvest-stall> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "barrel_canopy_and_valance_breeze_billow" , "organic_harvest_crate_and_basket_restock" , "reclaimed_material_rack_and_seed_chest_access" , "compost_tea_barrel_draw_off" ;
    made:lengthM "3.900"^^xsd:decimal ;
    made:widthM "2.200"^^xsd:decimal ;
    made:heightM "2.650"^^xsd:decimal ;
    made:curbMassKg "410.0"^^xsd:decimal ;
    made:modalSwayFreqHz "2.2"^^xsd:decimal ;
    made:totalAuthoredParts "29"^^xsd:integer ;
    made:hasComponent part:market-stall-counter , part:front-display-ledge , part:canopy-corner-post-0 , part:canopy-corner-post-1 , part:canopy-corner-post-2 , part:canopy-corner-post-3 , part:barrel-vault-canopy , part:canopy-valance-stripe-0 , part:canopy-valance-stripe-1 , part:canopy-valance-stripe-2 , part:display-basket-0 , part:harvest-crate-0 , part:display-basket-1 , part:harvest-crate-1 , part:display-basket-2 , part:harvest-crate-2 , part:organic-harvest-gourds , part:organic-leafy-greens ;
    made:hasPort port:stall-led-strip-12v , port:produce-weigh-scale-bus .

