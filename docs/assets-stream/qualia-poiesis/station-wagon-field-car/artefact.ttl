design:rev1 a made:Artefact , made:PassengerVehicle , dcat:Dataset ;
    owl:sameAs <did:q42:design:station_wagon_field_car> ;
    dct:identifier <urn:qualia:design:station-wagon-field-car:rev1> , <did:q42:design:station_wagon_field_car> ;
    rdfs:label "Corridor Touring Sedan & Field Station Wagon"@en ;
    dct:title "Corridor Touring Sedan & Field Station Wagon — Holographic 10D v2 & Hypermedia (.hmc) Digital Twin"@en ;
    dcat:landingPage <https://github.com/qualia-poiesis/station-wagon-field-car> ;
    odrl:hasPolicy "PermissiveCommons" ;
    q42:inalienableMoralRights "true"^^xsd:boolean ;
    q42:embodimentFormat "holographic-10d-v2" ;
    q42:multiscaleHierarchy "L0..L6 (L6QuantumPhysics)" ;
    q42:hasAnimationClip "corridor_cruising_wheel_and_damper_cycle" , "front_steering_and_cornering_roll" , "hood_and_tailgate_inspection_open" , "rooftop_telemetry_pod_calibration" ;
    made:lengthM "3.040"^^xsd:decimal ;
    made:widthM "1.780"^^xsd:decimal ;
    made:heightM "1.420"^^xsd:decimal ;
    made:curbMassKg "1620.0"^^xsd:decimal ;
    made:modalSwayFreqHz "1.6"^^xsd:decimal ;
    made:totalAuthoredParts "43"^^xsd:integer ;
    made:hasComponent part:chassis-underbody , part:lower-wagon-body , part:front-hood-deck , part:wheel-arch-trim-0 , part:wheel-arch-trim-1 , part:wheel-arch-trim-2 , part:wheel-arch-trim-3 , part:wagon-greenhouse , part:front-windshield , part:rear-tailgate-window , part:door-glass-front-left , part:door-glass-mid-left , part:cargo-glass-rear-left , part:side-mirror-left , part:door-glass-front-right , part:door-glass-mid-right , part:cargo-glass-rear-right , part:side-mirror-right ;
    made:hasPort port:aux-dc-bus-12v , port:rear-trailer-hitch .

