@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix crc: <urn:qualia:ontology:crc#> .
@prefix cml: <urn:qualia:ontology:cml#> .
@prefix hr: <urn:qualia:ontology:hr#> .

# -----------------------------------------------------------------------------
# Base Instrument Definition
# -----------------------------------------------------------------------------
crc:Instrument a hr:HumanRightsInstrument ;
    rdfs:label "Convention on the Rights of the Child" ;
    dcterms:title "Convention on the Rights of the Child" ;
    dcterms:description "A human rights treaty which sets out the civil, political, economic, social, health and cultural rights of children." ;
    hr:hasArticle crc:Article1, crc:Article2, crc:Article3 .

# -----------------------------------------------------------------------------
# Article 1 - Definition of a Child
# -----------------------------------------------------------------------------
crc:Article1 a hr:HumanRightsArticle ;
    rdfs:label "Article 1" ;
    dcterms:description "For the purposes of the present Convention, a child means every human being below the age of eighteen years unless under the law applicable to the child, majority is attained earlier." .

<< crc:Child hr:definedAs hr:HumanBeing >> 
    cml:semanticDefinition "A person who has not reached the age of majority." ;
    cml:temporalCondition "Age < 18 Years" ;
    cml:legalException "Unless majority is attained earlier by applicable national law." .

# -----------------------------------------------------------------------------
# Article 2 - Non-Discrimination
# -----------------------------------------------------------------------------
crc:Article2 a hr:HumanRightsArticle ;
    rdfs:label "Article 2" ;
    dcterms:description "States Parties shall respect and ensure the rights set forth in the present Convention to each child within their jurisdiction without discrimination of any kind." .

<< crc:Child hr:protectedAgainst hr:Discrimination >>
    cml:semanticDefinition "Protection applies irrespective of the child's or parent's race, colour, sex, language, religion, political or other opinion, national, ethnic or social origin, property, disability, birth or other status." ;
    cml:deonticStatus hr:ObligationOfState .

# -----------------------------------------------------------------------------
# Article 3 - Best Interests of the Child
# -----------------------------------------------------------------------------
crc:Article3 a hr:HumanRightsArticle ;
    rdfs:label "Article 3" ;
    dcterms:description "In all actions concerning children, whether undertaken by public or private social welfare institutions, courts of law, administrative authorities or legislative bodies, the best interests of the child shall be a primary consideration." .

<< hr:Action hr:prioritizes crc:BestInterestsOfChild >>
    cml:semanticDefinition "The holistic evaluation of a child's physical, mental, and emotional well-being must precede any institutional decision affecting them." ;
    cml:appliesToActor hr:PublicInstitution, hr:PrivateWelfare, hr:CourtOfLaw, hr:Legislature .
