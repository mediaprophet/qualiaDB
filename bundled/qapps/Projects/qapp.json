{
  "name": "Projects",
  "version": "0.1.0",
  "required_shapes": [
    "qualia:CooperativeProject",
    "qualia:ContributionLog",
    "qualia:EffortObligation",
    "qualia:WorkBoardCard"
  ],
  "x_qualia": {
    "app_id": "did:qualia:qap:projects",
    "display_name": "Cooperative Projects & Work",
    "category": "cooperative-work",
    "did_git": "did:git:github.com/webizen/qap-projects",
    "export_targets": [
      "tauri-desktop",
      "wasm-mobile",
      "embedded"
    ],
    "launch_modes": [
      "wasm-local",
      "online-daemon-aware",
      "static-web"
    ],
    "preferred_launch_mode": "wasm-local",
    "supports_offline": true,
    "requires": [
      { "capability": "qualia.service.scheduler", "required": true },
      { "capability": "qualia.service.networking", "required": true },
      { "capability": "qualia.service.permissive_commons", "required": true },
      { "capability": "qualia.service.communications", "required": true },
      { "capability": "qualia.service.identifiers", "required": true }
    ],
    "required_ontologies": [
      "q42:projects",
      "q42:work",
      "q42:obligations"
    ],
    "entrypoints": {
      "web": "index.html",
      "route": "/work"
    },
    "notes": [
      "Cooperative Projects & Work is developed in its own independent multi-repo package (did:git:github.com/webizen/qap-projects).",
      "Installs into {storage}/Qapps/Projects and records labor, capital, and effort obligations to the local QualiaDB NQuin ledger.",
      "Consumes the OS-Shell shared services: scheduler, networking, permissive commons, communications, and identifiers."
    ]
  }
}
