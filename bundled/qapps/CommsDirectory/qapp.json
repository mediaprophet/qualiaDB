{
  "name": "CommsDirectory",
  "version": "0.1.0",
  "required_shapes": [
    "qualia:ContactCard",
    "qualia:RelationshipConsent",
    "qualia:MessageEnvelope",
    "qualia:PermissiveDirectChannel"
  ],
  "x_qualia": {
    "app_id": "did:qualia:qap:comms-directory",
    "display_name": "Communications & Directory",
    "category": "communications",
    "did_git": "did:git:github.com/webizen/qap-comms-directory",
    "export_targets": [
      "tauri-desktop",
      "wasm-mobile",
      "embedded"
    ],
    "launch_modes": [
      "wasm-local",
      "online-daemon-aware",
      "static-web"
    ],
    "preferred_launch_mode": "wasm-local",
    "supports_offline": true,
    "requires": [
      { "capability": "qualia.service.scheduler", "required": true },
      { "capability": "qualia.service.networking", "required": true },
      { "capability": "qualia.service.permissive_commons", "required": true },
      { "capability": "qualia.service.communications", "required": true },
      { "capability": "qualia.service.identifiers", "required": true }
    ],
    "required_ontologies": [
      "q42:relations",
      "q42:directory",
      "q42:messaging"
    ],
    "entrypoints": {
      "web": "index.html",
      "route": "/talk/directory"
    },
    "notes": [
      "Communications & Directory is developed in its own independent repository (did:git:github.com/webizen/qap-comms-directory).",
      "Installs into {storage}/Qapps/CommsDirectory and drives sovereign peer address books, mail inboxes, and relationship topologies.",
      "Consumes the OS-Shell shared services: scheduler, networking, permissive commons, communications, and identifiers."
    ]
  }
}
