{
  "name": "LlmAgents",
  "version": "0.1.0",
  "required_shapes": [
    "qualia:ModelConfiguration",
    "qualia:AgentProfile",
    "qualia:InferenceSession",
    "qualia:InstrumentPermission"
  ],
  "x_qualia": {
    "app_id": "did:qualia:qap:llm-agents",
    "display_name": "LLM & Social AI Agents",
    "category": "ai-instruments",
    "did_git": "did:git:github.com/webizen/qap-llm-agents",
    "export_targets": [
      "tauri-desktop",
      "wasm-mobile",
      "embedded"
    ],
    "launch_modes": [
      "wasm-local",
      "online-daemon-aware",
      "static-web"
    ],
    "preferred_launch_mode": "wasm-local",
    "supports_offline": true,
    "requires": [
      { "capability": "qualia.service.scheduler", "required": true },
      { "capability": "qualia.service.networking", "required": true },
      { "capability": "qualia.service.permissive_commons", "required": true },
      { "capability": "qualia.service.communications", "required": true },
      { "capability": "qualia.service.identifiers", "required": true }
    ],
    "required_ontologies": [
      "q42:agents",
      "q42:inference",
      "q42:p64-weights"
    ],
    "entrypoints": {
      "web": "index.html",
      "route": "/tools"
    },
    "notes": [
      "LLM & Social AI Agents is developed in its own independent repository (did:git:github.com/webizen/qap-llm-agents).",
      "Installs into {storage}/Qapps/LlmAgents and controls local GGUF/P64 weight streaming under strict user allowlists.",
      "Consumes the OS-Shell shared services: scheduler, networking, permissive commons, communications, and identifiers."
    ]
  }
}
