@prefix q42:  <https://ns.webcivics.org/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix hcai: <http://www.w3.org/ns/hcai#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ===========================================================================
# Agency alignment — the human-centric PRIMITIVE.
#
#   A human being (Principal) may HAVE things but IS NOT a Thing.
#
# Grounding rationale (corrected 2026-06-21):
#   The native Qualia vocabulary is grounded in **RDFS classes + SHACL shapes**,
#   NOT in OWL. This is deliberate: in OWL, `owl:Thing` is the universal
#   superclass — every `owl:Class` individual is implicitly an `owl:Thing`.
#   Declaring a person as an `owl:Class`/`owl:Thing` therefore re-imports exactly
#   the reduction this project exists to refuse (a natural person is not a
#   "thing"; see HCAIO — http://www.w3.org/ns/hcai# — and the foundational
#   ontology: personhood/custody/agency are not properties of owl:Thing).
#   `owl:` appears below ONLY as a GUARD TARGET (`sh:not owl:Thing`) so that any
#   externally-supplied/legacy OWL typing of a Principal is rejected on ingest.
#   Incoming OWL vocabularies (RadLex, DICOM) are lowered to SHACL by owl.rs;
#   OWL is an input format here, never the metamodel for persons.
# ===========================================================================

# --- The Principal: a natural person with agency. Grounded in RDFS, aligned to HCAI. ---
q42:Principal a rdfs:Class ;
    rdfs:label "Principal (natural person with agency)" ;
    rdfs:comment "A human being acting with agency. NOT a Thing: not a subclass of owl:Thing or q42:Thing, and not reducible to either. Aligned to hcai:NaturalPerson." ;
    rdfs:seeAlso hcai:NaturalPerson .

# --- Reifiable entities: the possessions a Principal HAS (never the person). ---
q42:Thing a rdfs:Class ;
    rdfs:label "Reifiable entity" ;
    rdfs:comment "Clinical findings, anatomical structures, imaging series, documents, assets — possessions/objects related to a Principal. A Principal must never be typed as a q42:Thing." .

q42:ClinicalEntity a rdfs:Class ;
    rdfs:subClassOf q42:Thing ;
    rdfs:label "Clinical entity" .

q42:ImagingEntity a rdfs:Class ;
    rdfs:subClassOf q42:Thing ;
    rdfs:label "DICOM information entity (study/series/image)" .

# --- Possession relations: the Principal HAS these; the Principal IS NOT these. ---
q42:hasCondition a rdf:Property ;
    rdfs:domain q42:Principal ;
    rdfs:range q42:ClinicalEntity ;
    rdfs:comment "Principal possesses a condition; the Principal is not the condition." .

q42:hasFinding a rdf:Property ;
    rdfs:domain q42:Principal ;
    rdfs:range q42:ClinicalEntity .

q42:hasImagingStudy a rdf:Property ;
    rdfs:domain q42:Principal ;
    rdfs:range q42:ImagingEntity .

q42:hasDicomSeries a rdf:Property ;
    rdfs:domain q42:Principal ;
    rdfs:range q42:ImagingEntity .

# --- SHACL gates (compiled by shacl_compiler.rs → Webizen VM) ---
# These are the enforced, closed-world guards. `sh:not owl:Thing` / `sh:not q42:Thing`
# reject any attempt — including from imported OWL data — to reduce a person to a thing.

q42:PrincipalShape a sh:NodeShape ;
    sh:targetClass q42:Principal ;
    sh:not [
        sh:targetClass q42:Thing ;
        sh:message "A Principal (human being) must not be typed as a Thing." ;
    ] ;
    sh:not [
        sh:targetClass owl:Thing ;
        sh:message "A Principal must not be typed as owl:Thing." ;
    ] ;
    sh:property [
        sh:path q42:hasCondition ;
        sh:class q42:ClinicalEntity ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 0 ;
        sh:message "Conditions are possessions of the Principal, not identity of the Principal." ;
    ] ;
    sh:property [
        sh:path q42:hasFinding ;
        sh:class q42:ClinicalEntity ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path q42:hasImagingStudy ;
        sh:class q42:ImagingEntity ;
        sh:minCount 0 ;
    ] .

q42:ClinicalEntityShape a sh:NodeShape ;
    sh:targetClass q42:ClinicalEntity ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .
