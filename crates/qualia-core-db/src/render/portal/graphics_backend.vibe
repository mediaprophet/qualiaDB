// Renderer preference policy. Capability probing stays in the host; backend
// ordering belongs to VibeScript and can be reused by native hosts.
fn select_backend(webgpu: bool, webgl2: bool, canvas2d: bool) -> string {
    if webgpu {
        return "webgpu";
    } else {
        if webgl2 {
            return "webgl2";
        } else {
            if canvas2d {
                return "canvas2d";
            } else {
                return "unavailable";
            }
        }
    }
}

// A lost device is retried only when the host permits it. If that fails, keep
// the hardware fallback before settling for the Canvas2D proof path.
fn select_recovery_backend(webgpu_retry_allowed: bool, webgl2_allowed: bool) -> string {
    if webgpu_retry_allowed {
        return "webgpu";
    } else {
        if webgl2_allowed {
            return "webgl2";
        } else {
            return "canvas2d";
        }
    }
}

// Shared initial quality-tier policy. API/device probing remains in native/WASM hosts; the
// script receives normalized facts and owns the portable policy decision. Untrusted or partial
// probes always choose the presentation-safe Conservative tier (index 0).
fn select_quality_tier(probe_complete: bool, tier_hint: string) -> string {
    if !probe_complete {
        return "conservative";
    } else {
        if tier_hint == "ultra" {
            return "ultra";
        } else {
            if tier_hint == "high" {
                return "high";
            } else {
                if tier_hint == "balanced" {
                    return "balanced";
                } else {
                    if tier_hint == "low" {
                        return "low";
                    } else {
                        return "conservative";
                    }
                }
            }
        }
    }
}

// Pure VibeScript feature admission policy.
// Determines whether a specific graphics feature is admitted for a given quality tier.
fn admit_feature(tier: string, feature: string) -> bool {
    if tier == "ultra" || tier == "high" {
        return true;
    } else {
        if tier == "balanced" {
            return feature == "temporal_aa" || feature == "water_foam" || feature == "environment_probes";
        } else {
            if tier == "low" {
                return feature == "water_foam";
            } else {
                return false;
            }
        }
    }
}

// Selects procedural vegetation blade instance density by tier.
fn select_vegetation_density(tier: string) -> int {
    if tier == "ultra" {
        return 128;
    } else {
        if tier == "high" {
            return 64;
        } else {
            if tier == "balanced" {
                return 32;
            } else {
                if tier == "low" {
                    return 16;
                } else {
                    return 0;
                }
            }
        }
    }
}

// Selects water shader execution path by tier.
fn select_water_quality(tier: string) -> string {
    if tier == "ultra" || tier == "high" {
        return "full_foam_depth_waves";
    } else {
        if tier == "balanced" {
            return "foam_depth";
        } else {
            return "planar_unshaded";
        }
    }
}

// Selects TAA reconstruction mode by tier.
fn select_temporal_mode(tier: string) -> string {
    if tier == "ultra" || tier == "high" || tier == "balanced" {
        return "accumulate";
    } else {
        return "bypass";
    }
}

