// Renderer preference policy. Capability probing stays in the host; backend
// ordering belongs to VibeScript and can be reused by native hosts.
fn select_backend(webgpu: bool, webgl2: bool, canvas2d: bool) -> string {
    if webgpu {
        return "webgpu";
    } else {
        if webgl2 {
            return "webgl2";
        } else {
            if canvas2d {
                return "canvas2d";
            } else {
                return "unavailable";
            }
        }
    }
}

// A lost device is retried only when the host permits it. If that fails, keep
// the hardware fallback before settling for the Canvas2D proof path.
fn select_recovery_backend(webgpu_retry_allowed: bool, webgl2_allowed: bool) -> string {
    if webgpu_retry_allowed {
        return "webgpu";
    } else {
        if webgl2_allowed {
            return "webgl2";
        } else {
            return "canvas2d";
        }
    }
}

// Shared initial quality-tier policy. API/device probing remains in native/WASM hosts; the
// script receives normalized facts and owns the portable policy decision. Untrusted or partial
// probes always choose the presentation-safe Conservative tier (index 0).
fn select_quality_tier(probe_complete: bool, tier_hint: string) -> string {
    if !probe_complete {
        return "conservative";
    } else {
        if tier_hint == "ultra" {
            return "ultra";
        } else {
            if tier_hint == "high" {
                return "high";
            } else {
                if tier_hint == "balanced" {
                    return "balanced";
                } else {
                    if tier_hint == "low" {
                        return "low";
                    } else {
                        return "conservative";
                    }
                }
            }
        }
    }
}
