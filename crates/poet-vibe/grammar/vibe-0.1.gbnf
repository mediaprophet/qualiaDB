# vibe-0.1 GBNF — derived from vibescript-core.md §3.
# For Qualia's in-process constrained decode. Not an Ollama artifact.
# Does not accept the forbidden Quin overlay literal.

root ::= cell | module

cell ::= "=" ws expr

module ::= module-decl? import-decl* prefix-decl* requires-decl? item*

module-decl ::= "module" ws ( iri | ident ) ws ";"
import-decl ::= "import" ws string ws ( "as" ws ident ws )? ";"
prefix-decl ::= "prefix" ws ident ws ":" ws iri ws ";"
requires-decl ::= "requires" ws "[" ws cap-list? "]" ws ";"
cap-list ::= cap-spec ( ws "," ws cap-spec )*
cap-spec ::= "capability" "(" ws string ( ws "," ws ident ws ":" ws expr )* ws ")"

item ::= fn-decl | hook-decl | stmt
fn-decl ::= effect-class? ws "fn" ws ident ws "(" ws params? ")" ws ( "->" ws type-name )? ws block
hook-decl ::= "on" ws ident ( ":" ident )* ws "(" ws params? ")" ws block
effect-class ::= "pure" | "effect" | "hot" | "cold"

params ::= ident ws ":" ws type-name ( ws "," ws ident ws ":" ws type-name )*
type-name ::= "i32" | "u32" | "i64" | "u64" | "f32" | "f64" | "bool" | "string" | "Iri" | "Quin" | "Result" | "Receipt"

stmt ::= let-stmt | return-stmt | expr ws ";"
let-stmt ::= "let" ws "mut"? ws ident ( ws ":" ws type-name )? ( ws "=" ws expr )? ";"
return-stmt ::= "return" ws expr? ";"
block ::= "{" ws stmt* "}"

expr ::= primary ( ws postfix )*
postfix ::= "." ident | "(" ws args? ")" | "?"
args ::= expr ( ws "," ws expr )*
primary ::= number | string | ident | query-var | iri | prefixed | triple | reified | list | "(" ws expr ws ")"

triple ::= "<<(" ws expr ws expr ws expr ws ")>>"
reified ::= "<<" ws expr ws expr ws expr ws "~" ws expr ws ">>"

list ::= "[" ws ( expr ( ws "," ws expr )* )? "]"
ident ::= [A-Za-z_] [A-Za-z0-9_]*
query-var ::= "?" ident
prefixed ::= ident ":" [A-Za-z_] [A-Za-z0-9_.-]*
iri ::= "<" [^<>\s]+ ">"
string ::= "\"" ( [^"\\] | "\\" ["\\nrt] )* "\""
number ::= "-"? [0-9]+ ( "." [0-9]+ )?
ws ::= [ \t\n\r]*
