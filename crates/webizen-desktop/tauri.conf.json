{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webizen",
  "version": "0.0.34",
  "identifier": "org.webizen.browser",
  "build": {
    "frontendDist": "../webizen-studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Webizen",
        "width": 1200,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "copyright": "",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../webizen-studio/dist": "studio-dist",
      "static/portal": "portal",
      "../../docs/css": "portal-support/css",
      "../../docs/js": "portal-support/js",
      "../../docs/pkg/qualia": "portal-support/pkg/qualia",
      "../../docs/coi-serviceworker.js": "portal-support/coi-serviceworker.js"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQTNEMDE1M0M5ODdFMzcKUldRM2ZwZzhGZENqOGxwTVpFNm55c2RiVzdRWjBZQUp6YzF0Q0N6cWFValZVTDJ0NGx1d080VU8K",
      "endpoints": [
        "https://github.com/mediaprophet/qualiaDB/releases/latest/download/webizen-latest.json"
      ]
    }
  }
}
