{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webizen",
  "version": "0.0.24",
  "identifier": "org.webizen.browser",
  "build": {
    "frontendDist": "../webizen-studio/dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Webizen",
        "width": 1200,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "copyright": "",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../webizen-studio/dist": "studio-dist",
      "static/portal": "portal"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQ0NFQ0ZBMEUzRjk1QjQKUldTMGxUOE8rdXpNM3ZtcW5iQ1cxU2xtRTQxRHVxL2cyZTNSd3FUUzA1TTgyTm0vUk1RRWxtU0wK",
      "endpoints": [
        "https://github.com/mediaprophet/qualiaDB/releases/latest/download/webizen-latest.json"
      ]
    }
  }
}
