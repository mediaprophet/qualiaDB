module <https://qualiadb.org/modules/cosmic_celestial>;
requires [ capability("cosmic") ];
effect fn earth_gravity() -> f64 {
    return Cosmic.surface_gravity({ name: "earth" });
}
effect fn mars_gravity() -> f64 {
    return Cosmic.surface_gravity({ name: "mars" });
}
effect fn earth_profile() -> Record {
    return Cosmic.body_profile({ name: "earth" });
}
