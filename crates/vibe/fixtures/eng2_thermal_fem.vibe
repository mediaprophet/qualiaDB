# Engineering — thermal conduction and FEM static solve
invoke EngineeringAnalysis.analyze_conduction {
  length: 1.0,
  thermal_conductivity: 50.0,
  left_bc: { type: "Temperature", value: 300.0 },
  right_bc: { type: "Temperature", value: 400.0 },
  heat_generation: 0.0
}

invoke EngineeringAnalysis.fem_static {
  nodes: [[0.0, 0.0], [1.0, 0.0], [2.0, 0.0]],
  elements: [
    { type: "Truss", ni: 0, nj: 1, e: 200000.0, area: 0.01, rho: 7850.0 },
    { type: "Truss", ni: 1, nj: 2, e: 200000.0, area: 0.01, rho: 7850.0 }
  ],
  constraints: [[0, 0.0], [1, 0.0], [4, 0.0], [5, 0.0]],
  loads: [[2, -1000.0]]
}
