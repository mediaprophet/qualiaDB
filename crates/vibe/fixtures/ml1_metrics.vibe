# Machine learning — metrics, clustering, and data splitting
invoke MachineLearning.mse { y_true: [1.0, 2.0, 3.0], y_pred: [1.1, 1.9, 3.2] }
invoke MachineLearning.rmse { y_true: [1.0, 2.0, 3.0], y_pred: [1.1, 1.9, 3.2] }
invoke MachineLearning.mae { y_true: [1.0, 2.0, 3.0], y_pred: [1.1, 1.9, 3.2] }
invoke MachineLearning.r2_score { y_true: [1.0, 2.0, 3.0, 4.0], y_pred: [0.9, 2.1, 2.9, 4.1] }
invoke MachineLearning.accuracy { y_true: [0, 1, 1, 0, 1], y_pred: [0, 1, 0, 0, 1] }
invoke MachineLearning.roc_auc { scores: [0.9, 0.8, 0.4, 0.6], labels: [true, true, false, false] }
invoke MachineLearning.kmeans { data: [1.0, 1.0, 2.0, 2.0, 8.0, 8.0, 9.0, 9.0], n: 4, p: 2, k: 2, max_iter: 100, seed: 42 }
invoke MachineLearning.train_test_split { n: 100, test_ratio: 0.2, seed: 42 }
