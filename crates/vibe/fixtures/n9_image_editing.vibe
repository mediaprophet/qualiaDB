// VibeScript 0.1 — Image editing fixture
// Tests: Image.new, Image.add_layer, Image.fill, Image.brush, Image.apply_filter

let doc = Image.new({
  id: "img1",
  width: 800,
  height: 600,
});

let bg = Image.add_layer({
  id: "img1",
  name: "Background",
});

Image.fill({
  id: "img1",
  r: 32.0,
  g: 64.0,
  b: 128.0,
});

Image.brush({
  id: "img1",
  size: 15.0,
  points: [100.0, 100.0, 200.0, 200.0],
});

Image.apply_filter({
  id: "img1",
  filter: "grayscale",
  intensity: 0.5,
});

Image.composite({ id: "img1" });
