module <https://qualiadb.org/modules/svg_bezier>;
import "vibe:0.1/math" as m;
pure fn cubic_bezier_point(p0: f64, p1: f64, p2: f64, p3: f64, t: f64) -> f64 {
    let tc = m.clamp(t, 0.0, 1.0);
    let u = 1.0 - tc;
    let u2 = u * u;
    let u3 = u2 * u;
    let t2 = tc * tc;
    let t3 = t2 * tc;
    return u3 * p0 + 3.0 * u2 * tc * p1 + 3.0 * u * t2 * p2 + t3 * p3;
}
pure fn quadratic_bezier_point(p0: f64, p1: f64, p2: f64, t: f64) -> f64 {
    let tc = m.clamp(t, 0.0, 1.0);
    let u = 1.0 - tc;
    return u * u * p0 + 2.0 * u * tc * p1 + tc * tc * p2;
}
