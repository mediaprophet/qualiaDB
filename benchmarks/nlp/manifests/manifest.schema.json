{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://webcivics.org/qualia/nlp/benchmark-manifest.schema.json",
  "title": "Qualia NLP benchmark manifest (NLP-004)",
  "description": "Schema for evaluation manifests. Not a quality claim. Unset required thresholds are UNEVALUATED and never pass a release gate. Do not download datasets or models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task",
    "language",
    "dataset_id",
    "split",
    "metric_names",
    "seed",
    "seed_policy",
    "resource_envelope",
    "gate_status",
    "release_required"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_revision": { "type": ["string", "null"] },
    "split": {
      "type": "string",
      "enum": ["smoke", "train", "dev", "test", "calibration"]
    },
    "split_hash": { "type": ["string", "null"] },
    "domain": { "type": ["string", "null"] },
    "profile": { "type": ["string", "null"] },
    "label_mapping": { "type": ["string", "null"] },
    "scorer_revision": { "type": ["string", "null"] },
    "primary_metric": { "type": ["string", "null"] },
    "metric_names": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "minimum_score": { "type": ["number", "null"] },
    "achieved_score": { "type": ["number", "null"] },
    "baseline_score": { "type": ["number", "null"] },
    "noninferiority_margin": { "type": ["number", "null"] },
    "minimum_effect": { "type": ["number", "null"] },
    "confidence_method": { "type": ["string", "null"] },
    "coverage_floor": { "type": ["number", "null"] },
    "latency_budget": { "type": ["string", "null"] },
    "memory_budget": { "type": ["string", "null"] },
    "release_required": { "type": "boolean" },
    "gate_status": {
      "type": "string",
      "enum": ["UNEVALUATED", "unavailable", "blocked", "fail", "pass"]
    },
    "unavailable_reason": { "type": ["string", "null"] },
    "seed": { "type": "integer", "const": 42 },
    "seed_policy": { "type": "string", "const": "frozen-u64-42" },
    "resource_envelope": { "$ref": "#/definitions/resource_envelope" },
    "corpus": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional inline authored sentences. Smoke only. Never a substitute for a licensed corpus."
    },
    "notes": { "type": ["string", "null"] }
  },
  "definitions": {
    "resource_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "download_datasets", "download_models"],
      "properties": {
        "max_source_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "max_working_memory_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "network": { "type": "string", "enum": ["forbidden"] },
        "download_datasets": { "type": "boolean", "const": false },
        "download_models": { "type": "boolean", "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "gate_status": { "const": "unavailable" } },
        "required": ["gate_status"]
      },
      "then": {
        "required": ["unavailable_reason"],
        "properties": {
          "unavailable_reason": { "type": "string", "minLength": 8 }
        }
      }
    },
    {
      "if": {
        "properties": { "gate_status": { "const": "pass" } },
        "required": ["gate_status"]
      },
      "then": {
        "properties": {
          "minimum_score": { "type": "number" },
          "achieved_score": { "type": "number" }
        },
        "required": ["minimum_score", "achieved_score"]
      }
    }
  ]
}
